                  <field>
                     <name>TX_CYC_MODE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>UART TX loop mode enable bit</description>
                  </field>
                  <field>
                     <name>RX_CYC_MODE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>UART RX loop mode enable bit</description>
                  </field>
                  <field>
                     <name>DMA_PARS</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>UART DMA parity bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TBADR</name>
               <description>UART DMA TX base address register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TBADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>UART DMA TX base address</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RBADR</name>
               <description>UART DMA RX base address register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RBADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>UART DMA RX base address</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TLEN</name>
               <description>UART DMA TX length register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TLEN</name>
                     <bitRange>[14:0]</bitRange>
                     <description>UART DMA TX length</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RLEN</name>
               <description>UART DMA RX length register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RLEN</name>
                     <bitRange>[14:0]</bitRange>
                     <description>UART DMA RX length</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TADR</name>
               <description>UART DMA TX current address register</description>
               <addressOffset>0x2C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>UART DMA TX current address</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RADR</name>
               <description>UART DMA RX current address register</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>UART DMA RX current address</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_IE</name>
               <description>UART DMA interrupt enable register</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_HIE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>DMA TX half-full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>TX_FIE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA TX empty interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_HIE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>DMA RX half-full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_FIE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>DMA RX full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>TX_ERR_IE</name>
                     <bitRange>[4:4]</bitRange>
                     <description>DMA TX error interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_ERR_IE</name>
                     <bitRange>[5:5]</bitRange>
                     <description>DMA RX error interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_IF</name>
               <description>UART DMA interrupt flag register</description>
               <addressOffset>0x38</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_HIF</name>
                     <bitRange>[0:0]</bitRange>
                     <description>DMA TX half-full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX_FIF</name>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA TX empty interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_HIF</name>
                     <bitRange>[2:2]</bitRange>
                     <description>DMA RX half-full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_FIF</name>
                     <bitRange>[3:3]</bitRange>
                     <description>DMA RX full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_ERR_IF</name>
                     <bitRange>[5:5]</bitRange>
                     <description>DMA RX error interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_DONE_IF</name>
                     <bitRange>[6:6]</bitRange>
                     <description>DMA RX done interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
