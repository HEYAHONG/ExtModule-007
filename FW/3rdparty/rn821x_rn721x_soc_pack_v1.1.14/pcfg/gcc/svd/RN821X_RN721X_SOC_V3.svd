                        <enumeratedValue>
                           <name>NEG</name>
                           <description>reactive power change from postive to negative</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOPLD</name>
                     <access>read-only</access>
                     <bitRange>[27:27]</bitRange>
                     <description>active power too small flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BIG</name>
                           <description>active power greater than or equal with starting power</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SMALL</name>
                           <description>active power less than starting power</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
