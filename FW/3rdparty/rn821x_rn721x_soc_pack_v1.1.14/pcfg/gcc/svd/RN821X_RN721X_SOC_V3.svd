                        <enumeratedValue>
                           <name>1</name>
                           <description>when negative active power is detected ,set the bit as 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REVQ</name>
                     <access>read-only</access>
                     <bitRange>[1:1]</bitRange>
                     <description>indication of reverse reactive power</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>when the next detecting result is positive reactive power ,clear the bit as 0 .</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when negative reactive power is detected ,set the bit as 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOPLD</name>
                     <access>read-only</access>
                     <bitRange>[2:2]</bitRange>
                     <description>active power and starting power status register</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>When active power is more than or equal to starting power ,Nopld is clear to 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when active power is less than starting power ,Nopld is set to 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOQLD</name>
