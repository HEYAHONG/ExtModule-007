                        <enumeratedValue>
                           <name>INVL</name>
                           <description>set as invalid level</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TOG</name>
                           <description>toggle output</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FVL</name>
                           <description>force as valid level</description>
                           <value>4</value>
