         </registers>
         <interrupt>
            <name>NVM</name>
            <value>23</value>
            <description>39 NVM or SPI1 Interrupt</description>
         </interrupt>
      </peripheral>
      <peripheral>
         <name>RTC</name>
         <description>real time clock</description>
         <groupName>RTC</groupName>
         <baseAddress>0x4003C000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x18C</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>FOUT</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
                     <description>output frequency selections bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>output forbidden</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1HZ</name>
                           <description>output PLL_1Hz when PLL_MODE=1,output LOSC_1Hz when PLL_MODE=0</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_30HZ</name>
                           <description>select output frequency of 1/30Hz</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32KHZ</name>
                           <description>select output frequency of 32768Hz</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16HZ</name>
                           <description>select output frequency of 16Hz</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8HZ</name>
                           <description>select output frequency of 8Hz</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4HZ</name>
                           <description>select output frequency of 4Hz</description>
                           <value>6</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TCP</name>
                     <access>read-write</access>
                     <bitRange>[5:3]</bitRange>
                     <description>temperature compensation period bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2S</name>
                           <description>select temperature compensation period as 2 second</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>10S</name>
                           <description>select temperature compensation period as 10 second</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>20S</name>
                           <description>select temperature compensation period as 20 second</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>30S</name>
                           <description>select temperature compensation period as 30 second</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1MIN</name>
                           <description>select temperature compensation period as 1 minute</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2MIN</name>
                           <description>select temperature compensation period as 2 minute</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>5MIN</name>
                           <description>select temperature compensation period as 5 minute</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>10MIN</name>
                           <description>select temperature compensation period as 10 minute</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TSE</name>
                     <access>read-write</access>
                     <bitRange>[7:6]</bitRange>
                     <description>temperature sensor enable configuration bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable automatic temperature compensation</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AUTOEN</name>
                           <description>enable automatic cyclic temperature compensation</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>USER0EN</name>
                           <description>enable user mode 0, automatic temperature compensation triggered by setting temperature(temperature set by user)</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>USER1EN</name>
                           <description>enable user mode 1, automatic temperature compensation triggered by setting temperature(temperature unchangeable)</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WRTC</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>RTC register write enable/disable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>RTC register set as read_only</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>RTC register set as writable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WR_BUSY</name>
                     <access>read-only</access>
                     <bitRange>[9:9]</bitRange>
                     <description>RTC register writing busy flag (RTC register only can be changed or set when Wr_busy is 0)</description>
                  </field>
                  <field>
                     <name>CAL_BUSY</name>
                     <access>read-only</access>
                     <bitRange>[10:10]</bitRange>
                     <description>RTC calibration busy flag</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SC</name>
               <description>seconds register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">SC</name>
                     <bitRange>[6:0]</bitRange>
                     <description>seconds bits (BCD format, SC[6:4] standing for 10 seconds,SC[3:0] standing seconds)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MN</name>
               <description>minutes register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MN</name>
                     <bitRange>[6:0]</bitRange>
                     <description>minutes bits (BCD format, MN[6:4] standing for 10 minutes,MN[3:0] standing for minutes)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>HR</name>
               <description>hours register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">HR</name>
                     <bitRange>[5:0]</bitRange>
                     <description>hours bits (BCD format, HR[5:4] standing for 10 hours,HR[3:0] standing for hours)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DT</name>
               <description>date register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DT</name>
                     <bitRange>[5:0]</bitRange>
                     <description>date bits (BCD format, DT[5:4] standing for 10 date,DT[3:0] standing for date)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MO</name>
               <description>month register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MO</name>
                     <bitRange>[4:0]</bitRange>
                     <description>month bits (BCD format, MO[5] standing for 10 month,MO[3:0] standing for month)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>YR</name>
               <description>year register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">YR</name>
                     <bitRange>[7:0]</bitRange>
                     <description>year bits (BCD format, YR[7:4] standing for 10 year,YR[3:0] standing for year)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DW</name>
               <description>day of the week register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DW</name>
                     <bitRange>[2:0]</bitRange>
                     <description>day of the week bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CNT1</name>
               <description>RTC counter1 register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CNT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC counter1 perset value bits(set CNT1 flag every (CNT+1) seconds)</description>
                  </field>
                  <field>
                     <name>PD</name>
                     <bitRange>[8:8]</bitRange>
                     <description>RTC CNT1 ON/OFF control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>counter1 on (from perpetual calendar second interrupt)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>counter1 off, reset the counter value and restart</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CNT2</name>
               <description>RTC counter2 register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CNT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC counter2 perset value bits(set counter2 flag every (CNT+1)/256 seconds)</description>
                  </field>
                  <field>
                     <name>PD</name>
                     <bitRange>[8:8]</bitRange>
                     <description>RTC CNT2 ON/OFF control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>counter2 on(from internal 1/256 s interrupt)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>counter2 off, reset the counter value</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SCA</name>
               <description>alarm seconds register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">SCA</name>
                     <bitRange>[6:0]</bitRange>
                     <description>alarm seconds bits (BCD format,SCA[6:4] standing for 10 seconds,SCA[3:0] standing for seconds)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MNA</name>
               <description>alarm minitues register</description>
               <addressOffset>0x2C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MNA</name>
                     <bitRange>[6:0]</bitRange>
                     <description>alarm minitues bits (BCD format,MNA[6:4] standing for 10 minitues,MNA[3:0] standing for minitues)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>HRA</name>
               <description>alarm hours register</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">HRA</name>
                     <bitRange>[5:0]</bitRange>
                     <description>alarm hours bits (BCD format,MNA[5:4] standing for 10 hours,MNA[3:0] standing for hours)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>interrupt enable register</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>ALMIE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>alarm interrupt enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>enable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>disable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>RTCCNT1IE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>counter1 interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>RTCCNT2IE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>counter2 interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>SCIE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>sencond interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>MNIE</name>
                     <bitRange>[4:4]</bitRange>
                     <description>minute interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>HRIE</name>
                     <bitRange>[5:5]</bitRange>
                     <description>hour interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>DTIE</name>
                     <bitRange>[6:6]</bitRange>
                     <description>date interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>MOIE</name>
                     <bitRange>[7:7]</bitRange>
                     <description>month interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>IECLKEN</name>
                     <bitRange>[8:8]</bitRange>
                     <description>interrupt clock enable bit.enabled when any bit of RTC_IE[8:0] is high</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>RTC_1S_SEL</name>
                     <bitRange>[9:9]</bitRange>
                     <description>RTC_1S clock source selection bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>RTC interrupt flags register</description>
               <addressOffset>0x38</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>ALMIF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>alarm event interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>no outstanding alarm event occurred</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OCC</name>
                           <description>event accured</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="ALMIF">
                     <name>RTCCNT1IF</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>counter1 event interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="ALMIF">
                     <name>RTCCNT2IF</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>counter2 event interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="ALMIF">
                     <name>SCIF</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>sencond event interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="ALMIF">
                     <name>MNIF</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>minute event interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="ALMIF">
                     <name>HRIF</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>hour event interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="ALMIF">
                     <name>DTIF</name>
                     <access>read-write</access>
