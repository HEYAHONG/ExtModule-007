                  </field>
                  <field>
                     <name>LMSB</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>LSB or MSB selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MSB</name>
                           <description>MSB transmitted first</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LSB</name>
                           <description>LSB transmitted first</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CPOL</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>clock polarity selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EL</name>
