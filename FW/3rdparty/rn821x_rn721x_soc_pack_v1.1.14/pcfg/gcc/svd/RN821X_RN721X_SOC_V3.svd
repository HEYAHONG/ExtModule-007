            </register>
            <register>
               <name>OSC_CTRL2</name>
               <description>system oscillator control No.2</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>PLL_HOSC_SEL</name>
                     <bitRange>[4:4]</bitRange>
                     <description>system clock selection bits for full speed mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PLL</name>
                           <description>select PLL as system clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HOSC</name>
                           <description>select HOSC as system clock</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PLL_FREQ</name>
                     <bitRange>[7:5]</bitRange>
                     <description>PLL freq selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>7M4</name>
                           <description>PLL freq select 7.3728MHz</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7</name>
                           <description>PLL freq select 14.7456Mhz</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5</name>
                           <description>PLL freq select 29.4912Mhz</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>59M_DIV2</name>
                           <description>PLL freq select 58.9824Mhz divided by 2</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LOSC_PD</name>
                     <bitRange>[8:8]</bitRange>
                     <description>LOSC power down switch bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>power on</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>power off</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LOSC_WEN</name>
                     <bitRange>[9:9]</bitRange>
                     <description>LOSC_PD writable enable/disable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>LOSC_PD write disable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>LOSC_PD write enable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="ALL_ENUM">
                     <name>RCL_LOSC_SYS_SEL</name>
                     <bitRange>[12:12]</bitRange>
                     <description>system clock selection bit for low frequency mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LOSC</name>
                           <description>select LOSC</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCL</name>
                           <description>select RCL</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="RCL_LOSC_SYS_SEL">
                     <name>RCL_LCD</name>
                     <bitRange>[13:13]</bitRange>
                     <description>clock selection bit (RCL/LOSC) for LCD</description>
                  </field>
                  <field derivedFrom="RCL_LOSC_SYS_SEL">
                     <name>RCL_LOSC_RTC_SEL</name>
                     <bitRange>[14:14]</bitRange>
                     <description>clock selection bit (RCL/LOSC) for RTC</description>
                  </field>
                  <field derivedFrom="RCL_LOSC_SYS_SEL">
                     <name>RCL_LOSC_FLT_SEL</name>
                     <bitRange>[15:15]</bitRange>
                     <description>clock selection bit (RCL/LOSC) for KBI filter</description>
                  </field>
                  <field>
                     <name>RCH_FREQ</name>
                     <bitRange>[18:16]</bitRange>
                     <description>RCH frequency selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1M8</name>
                           <description>internal RCH freq select 1.8432MHz</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3M6</name>
                           <description>internal RCH freq select 3.6864MHz</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7M4</name>
                           <description>internal RCH freq select 7.3728MHz</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7</name>
                           <description>internal RCH freq select 14.7456Mhz</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5</name>
                           <description>internal RCH freq select 29.4912Mhz</description>
                           <value>4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RCM_PD</name>
                     <bitRange>[20:20]</bitRange>
                     <description>internal RCM enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>power off</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>power on</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PM_SEL</name>
                     <bitRange>[22:22]</bitRange>
                     <description>EMU power mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NORM</name>
                           <description>select as normal mode</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NVM</name>
                           <description>select as NVM mode</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYS_RST</name>
               <description>system reset  register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>EMU_RST_REQ</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>EMU module soft reset cfg bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable module soft reset</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable module soft reset</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="EMU_RST_REQ">
                     <name>NVM_RST_REQ</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>NVM module soft reset cfg bit</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>LOCKUP_ENRST</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>selection for the connection of lockup and system reset</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>lock up can not cause system reset</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>lock up cause system reset</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="EMU_RST_REQ">
                     <name>EMUREG_RST_REQ</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>EMU/NVM/FLK module soft reset cfg bit</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>POWEROK_RST</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>power-on reset flag (=1 reset ccured)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OCC</name>
                           <description>reset occured</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>reset not occured</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="POWEROK_RST">
                     <name>PIN_RST</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>external pin reset flag (=1 reet occured)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="POWEROK_RST">
                     <name>WDT_RST</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>WDT reset flag (=1 reset occurd)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="POWEROK_RST">
                     <name>MCU_RST</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>CPU reset flag(software or LOCKUP) (=1 reset occured)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>BOR_V2P8_ENRST</name>
                     <access>read-write</access>
                     <bitRange>[9:9]</bitRange>
                     <description>lower than BOR 2.8V threshold reset CPU cfg bit</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>BOR_V2P8_IE</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
                     <description>BOR 2.8V threshold interrupt enable bit</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>BOR_V2P8_IF</name>
                     <access>read-write</access>
                     <bitRange>[11:11]</bitRange>
                     <description>BOR 2.8V threshold interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>CM0_ENRST</name>
                     <access>read-write</access>
                     <bitRange>[12:12]</bitRange>
                     <description>CM0 reset enable bit(do not reset EMU related module)</description>
                  </field>
                  <field derivedFrom="POWEROK_RST">
                     <name>CM0_RST</name>
                     <access>read-write</access>
