            </register>
            <register>
               <name>D2FP1</name>
               <description>D2F power 1 vaule</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">D2FP1</name>
                     <bitRange>[23:0]</bitRange>
                     <description>D2F power 1 vaule</description>
