                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EH</name>
                           <description>select high level for 'SCK' empty status</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CPHA</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>clock phase selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SAMP</name>
