                  </field>
                  <field derivedFrom="UART0_CLKG">
                     <name>UART1_CLKG</name>
                     <access>read-write</access>
                     <bitRange>[15:15]</bitRange>
                     <description>UART1 CM0 reset lock enable bit(during CM0 reset period lock transmission between CPU and UART)</description>
                  </field>
                  <field derivedFrom="UART0_CLKG">
                     <name>UART2_CLKG</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>UART2 CM0 reset lock enable bit(during CM0 reset period lock transmission between CPU and UART)</description>
                  </field>
                  <field derivedFrom="UART0_CLKG">
                     <name>UART3_CLKG</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
