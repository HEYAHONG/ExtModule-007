                           <description>select LDO 3.24v as output level</description>
                           <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P3</name>
                           <description>select LDO 3.3v  as output level</description>
                           <value>10</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P36</name>
