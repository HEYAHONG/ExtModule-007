               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>LCD module enable/disable bit</description>
                  </field>
                  <field>
                     <name>DUTY</name>
                     <bitRange>[3:1]</bitRange>
                     <description>LCD duty cycle selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
