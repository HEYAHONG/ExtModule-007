                           <description>static output (COM0)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_2</name>
                           <description>duty cycle = 1/2 (COM0~1)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_3</name>
                           <description>duty cycle = 1/3 (COM0~2)</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_4</name>
                           <description>duty cycle = 1/4 (COM0~3)</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_6</name>
                           <description>duty cycle = 1/6 (COM0~5)</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_8</name>
                           <description>duty cycle = 1/8 (COM0~7)</description>
                           <value>5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BIAS</name>
                     <bitRange>[4:4]</bitRange>
                     <description>LCD voltage bias control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1_3</name>
                           <description>select LCD bias as 1/3 voltage bias</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_4</name>
                           <description>select LCD bias as 1/3 voltage bias</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BIASLVL</name>
                     <bitRange>[10:5]</bitRange>
                     <description>LCD voltage Bias configuration bits</description>
                  </field>
                  <field>
                     <name>TYPE</name>
                     <bitRange>[11:11]</bitRange>
                     <description>LCD drive type selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>A</name>
                           <description>select LCD drive type A as LCD drive type</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>B</name>
                           <description>select LCD drive type B as LCD drive type</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PWD_PUMP</name>
                     <bitRange>[12:12]</bitRange>
