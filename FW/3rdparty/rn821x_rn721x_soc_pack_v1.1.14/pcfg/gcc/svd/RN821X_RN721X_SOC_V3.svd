                           <description>no operation</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>START</name>
                           <description>start clock trim(cleared auto while counter down)</description>
                           <value>1</value>
                        </enumeratedValue>
