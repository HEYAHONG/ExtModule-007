      <peripheral>
         <name>LCD</name>
         <description>liquid crystal display</description>
         <groupName>LCD</groupName>
         <baseAddress>0x40048000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x46</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
