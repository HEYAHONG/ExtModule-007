                        <enumeratedValue>
                           <name>FINVL</name>
                           <description>force as invalid level</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PWM1</name>
                           <description>when tc_cnt less than tc_ccdx, set output as valid level</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PWM2</name>
                           <description>when tc_cnt greater than tc_ccdx, set output as valid level</description>
                           <value>7</value>
