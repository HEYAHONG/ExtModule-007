      </peripheral>
      <peripheral>
         <name>TC1</name>
         <description>A 32-bit timer</description>
         <groupName>TIMER</groupName>
         <baseAddress>0x40014000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x50</size>
            <usage>registers</usage>
         </addressBlock>
         <resetValue>0</resetValue>
         <registers>
            <register>
               <name>CNT</name>
               <description>current counting value register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">CNT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>current Timer counter value bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PS</name>
               <description>prescaler value register of the counter clock</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">PS</name>
                     <bitRange>[15:0]</bitRange>
                     <description>prescaler value bits of the counter clock</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DN</name>
               <description>target counting value register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DN</name>
                     <bitRange>[31:0]</bitRange>
                     <description>target counting value bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCD0</name>
               <description>capture(compare) channel No.0 data register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CCD0</name>
                     <bitRange>[31:0]</bitRange>
                     <description>capture(compare) channel No.0 data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCD1</name>
               <description>capture(compare) channel No.1 data register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CCD1</name>
                     <bitRange>[31:0]</bitRange>
                     <description>capture(compare) channel No.1 data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCFG</name>
               <description>clock config register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CM</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>clock mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INT</name>
                           <description>using on-chip system clock as input counting clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXT</name>
                           <description>using external clock(to the timer) as input counting clock(refer to bitfield CS of register TC_CCFG for clock selection)</description>
