      <peripheral>
         <name>WDT</name>
         <description>watchdog timer</description>
         <groupName>WDT</groupName>
         <baseAddress>0x40030000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x20</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>EN</name>
               <description>Watchdog enable register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>WDTE</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>WDT enable bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RESTART</name>
                           <description>clear WDT counter and restart WDT(write value)</description>
                           <value>0xBB</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS_DFLT</name>
                           <description>WDTE default value</description>
                           <value>0x55</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WR_BUSY</name>
                     <access>read-only</access>
                     <bitRange>[8:8]</bitRange>
                     <description>WDT write busy flag</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRL</name>
               <description>WDT control register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>WDCS</name>
                     <access>read-write</access>
                     <bitRange>[3:1]</bitRange>
                     <description>WDT overflow time config</description>
                  </field>
                  <field>
                     <name>WINDOW</name>
                     <access>read-write</access>
                     <bitRange>[6:5]</bitRange>
                     <description>WDT Window Open Period</description>
                  </field>
                  <field>
                     <name>WDTINT</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>WDT Timer Interval Interrupt</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PASS</name>
               <description>WDT password register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>L</name>
                     <access>read-write</access>
                     <bitRange>[3:0]</bitRange>
                     <description>WDT low part password</description>
                  </field>
                  <field>
                     <name>H</name>
                     <access>read-only</access>
                     <bitRange>[7:4]</bitRange>
                     <description>WDT high part password</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>HALT</name>
