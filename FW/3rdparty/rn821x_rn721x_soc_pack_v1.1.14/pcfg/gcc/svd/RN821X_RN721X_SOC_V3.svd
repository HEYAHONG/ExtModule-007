                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>resistors is always driven</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
