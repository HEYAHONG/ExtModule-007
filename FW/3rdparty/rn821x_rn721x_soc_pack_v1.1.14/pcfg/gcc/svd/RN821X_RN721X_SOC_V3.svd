                           <description>select positive output of channel 1 of the other TC (TC1/TC0)</description>
                           <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART4_RXD</name>
                           <description>select UART4_RXD</description>
