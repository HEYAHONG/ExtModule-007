                           <description>clock trim counter not overflow</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OV</name>
                           <description>clock trim counter overflow</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>START</name>
                     <access>read-write</access>
