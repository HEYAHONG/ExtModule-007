                  </field>
               </fields>
            </register>
            <register>
               <name>RESCTL</name>
               <description>LCD internal resistance control register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>IRSN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>resistance divider mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IR</name>
                           <description>select internal resistance divider mode</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RSM</name>
                     <bitRange>[1:1]</bitRange>
                     <description>internal resistance divider mode signal selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SO</name>
                           <description>20k resistor time sharing connected, 200k resistor short circuited</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SL</name>
                           <description>time sharing switching between 20k resistor and 200k resistor</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RES_FT</name>
                     <bitRange>[3:2]</bitRange>
                     <description>resistance divider mode driving times(one screen refresh cycle) configuration bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1</name>
                           <description>driving once per cycle</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>driving 2 times per cycle</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>driving 3 times per cycle</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>driving 4 times per cycle</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RES_DT</name>
                     <bitRange>[6:4]</bitRange>
                     <description>resistance divider mode driving time (one screen refresh cycle) configuration bits</description>
                  </field>
                  <field>
                     <name>RES_AO</name>
                     <bitRange>[7:7]</bitRange>
                     <description>resistance divider mode driver control switch</description>
