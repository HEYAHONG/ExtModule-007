                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P82</name>
                           <description>select LDO 2.82v as output level</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P88</name>
                           <description>select LDO 2.88v as output level</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P94</name>
                           <description>select LDO 2.94v as output level</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P0</name>
                           <description>select LDO 3.0v  as output level</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P06</name>
                           <description>select LDO 3.06v as output level</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P12</name>
                           <description>select LDO 3.12v as output level</description>
                           <value>7</value>
