               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">TXDFLT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>transmit default data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_CTRL</name>
               <description>SPI DMA control register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>TX_DMA_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>transmit DMA enable bit</description>
                  </field>
                  <field>
                     <name>RX_DMA_EN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
