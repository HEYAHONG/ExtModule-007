                  </field>
                  <field>
                     <name>TX_CYC_MODE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>periodic transmit enable bit</description>
                  </field>
                  <field>
                     <name>RX_CYC_MODE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>periodic receive enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TBADR</name>
               <description>SPI DMA TX base address register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TBADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>DMA transmit begin addr configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RBADR</name>
               <description>SPI DMA RX base address register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RBADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>DMA receive  begin addr configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TLEN</name>
               <description>SPI DMA TX length register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TLEN</name>
                     <bitRange>[14:0]</bitRange>
                     <description>DMA transmit length configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RLEN</name>
               <description>SPI DMA RX length register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RLEN</name>
                     <bitRange>[14:0]</bitRange>
                     <description>DMA receive  length configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TADR</name>
               <description>SPI DMA TX current address register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>current transmit DMA addr bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RADR</name>
               <description>SPI DMA RX current address register</description>
               <addressOffset>0x2C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>current receive  DMA addr bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_IE</name>
               <description>SPI DMA interrupt enable register</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>TX_HIE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>DMA transmit half-full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>TX_FIE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA receive full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_HIE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>DMA transmit half-full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_FIE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>DMA receive full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>TX_ERR_IE</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>DMA transmit error interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_ERR_IE</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>DMA receive error(data recover) interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_FLG</name>
               <description>SPI DMA interrupt flag register</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>TX_HDONE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>DMA transmit half-full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX_FDONE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA transmit full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_HDONE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>DMA receive half-full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_FDONE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>DMA receive full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_ERR</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>DMA receive error interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral derivedFrom="SPI1">
         <name>SPI3</name>
         <groupName>SPI</groupName>
         <baseAddress>0x40058000</baseAddress>
      </peripheral>
      <peripheral>
         <name>SYSCTL</name>
         <description>system control</description>
         <groupName>SYSTEM</groupName>
         <baseAddress>0x40034000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x11C</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>OSC_CTRL1</name>
               <description>system oscillator control register No.1</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>PLL_PD</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>PLL disable bit (=1 disable, =0 enable)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="PLL_PD">
                     <name>IRCH_PD</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>internal RCH oscillator disable bit (=1 disable, =0 enable)</description>
                  </field>
                  <field>
                     <name>PLL_HOSC_DIV</name>
                     <access>read-write</access>
                     <bitRange>[3:2]</bitRange>
                     <description>system clock division(applicable for high frequency mode(only for PLL))</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIV1</name>
                           <description>when PLL/HOSC selected as system clock not divided</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV2</name>
                           <description>when PLL/HOSC selected as system clock divided by 2</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV4</name>
                           <description>when PLL/HOSC selected as system clock divided by 4</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV8</name>
                           <description>when PLL/HOSC selected as system clock divided by 8</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>LOSC_ON</name>
                     <access>read-only</access>
                     <bitRange>[4:4]</bitRange>
                     <description>system clock flag of losc or RCL</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>losc isn't used as system clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SYS_CLK</name>
                           <description>losc used as system clock</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>IRCH_ON</name>
                     <access>read-only</access>
                     <bitRange>[5:5]</bitRange>
                     <description>system clock flag of internal RC oscillator</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>IRCH isn't used as system clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SYS_CLK</name>
                           <description>IRCH used as system clock</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>PLL_HOSC_ON</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>system clock flag of internal PLL</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>PLL_HOSC isn't used as system clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SYS_CLK</name>
                           <description>PLL_HOSC used as system clock</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>PLL_LOCK</name>
                     <access>read-only</access>
                     <bitRange>[7:7]</bitRange>
                     <description>PLL locked flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>PLL hasn't locked yet</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOCK</name>
                           <description>PLL locked</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SYSCLK_STAT</name>
                     <access>read-only</access>
                     <bitRange>[10:8]</bitRange>
                     <description>system clock freq status flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>7M4</name>
                           <description>current system clock freq = 7.3728MHz</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3M6</name>
                           <description>current system clock freq = 3.6864MHz</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1M8</name>
                           <description>current system clock freq = 1.8432MHz</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32K</name>
                           <description>current system clock freq = 32.768KHz</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7</name>
                           <description>current system clock freq = 14.7456Mhz</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5</name>
                           <description>current system clock freq = 29.4912Mhz</description>
                           <value>5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>LOSC_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[11:11]</bitRange>
                     <description>LOSC ON status flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>clock off</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>clock on</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="LOSC_CLOCK_FLAG">
                     <name>PLL_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[12:12]</bitRange>
                     <description>PLL ON status flag</description>
                  </field>
                  <field derivedFrom="LOSC_CLOCK_FLAG">
                     <name>RCH_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[13:13]</bitRange>
                     <description>internal RCH ON status flag</description>
                  </field>
                  <field derivedFrom="LOSC_CLOCK_FLAG">
                     <name>RCL_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[14:14]</bitRange>
                     <description>internal RCL ON status flag</description>
                  </field>
                  <field derivedFrom="LOSC_CLOCK_FLAG">
                     <name>RCM_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[16:16]</bitRange>
                     <description>RCM ON status flag</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYS_MODE</name>
               <description>system mode control register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MODE</name>
                     <access>read-write</access>
                     <bitRange>[3:0]</bitRange>
                     <description>system clock configuration bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HCM</name>
                           <description>select HCM mode as system mode</description>
                           <value>13</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCM</name>
                           <description>select RCM mode as system mode</description>
                           <value>14</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LCM</name>
                           <description>select LCM mode as system mode</description>
                           <value>15</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>FLASH_BUSY</name>
                     <access>read-only</access>
                     <bitRange>[5:5]</bitRange>
                     <description>FLASH busy status flag (=1 busy, =0 idle)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <description>idle</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <description>idle</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYS_PD</name>
               <description>system power-down control register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>ADCI1_PD</name>
                     <bitRange>[0:0]</bitRange>
                     <description>I1 ADC power down switch bit(=1 power down, =0 power on)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>power on</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>power off</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>ADCI2_PD</name>
                     <bitRange>[1:1]</bitRange>
                     <description>I2 ADC power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>ADCU_PD</name>
                     <bitRange>[2:2]</bitRange>
                     <description>U ADC power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>LVD_PD</name>
                     <bitRange>[3:3]</bitRange>
                     <description>LVD power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>CMP1_PD</name>
                     <bitRange>[4:4]</bitRange>
                     <description>power down switch bit of Comparator No.1 (=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>CMP2_PD</name>
                     <bitRange>[5:5]</bitRange>
                     <description>power down switch bit of Comparator No.2 (=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>BGR_PD</name>
                     <bitRange>[6:6]</bitRange>
                     <description>BGR power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>BGRLP_PD</name>
                     <bitRange>[7:7]</bitRange>
                     <description>BGRLP power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field enums="ALL_ENUM">
                     <name>PWD_CMP1R</name>
                     <bitRange>[8:8]</bitRange>
                     <description>switch bit of CMP1 internal simpling resistor(=1 register off, =0 register on)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>switch on</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>switch off</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="PWD_CMP1R">
                     <name>PWD_CMP2R</name>
                     <bitRange>[9:9]</bitRange>
                     <description>switch bit of CMP2 internal simpling resistor(=1 register off, =0 register on)</description>
                  </field>
                  <field enums="ALL_ENUM">
                     <name>HYSEN_CMP1</name>
                     <bitRange>[10:10]</bitRange>
                     <description>CMP1 hysteresis switch bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>switch on</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>switch off</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="HYSEN_CMP1">
                     <name>HYSEN_CMP2</name>
                     <bitRange>[11:11]</bitRange>
                     <description>CMP2 hysteresis switch bit</description>
                  </field>
                  <field>
                     <name>VSEL_BOR5</name>
                     <bitRange>[16:16]</bitRange>
                     <description>BOR5 voltage threshold bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <description>BOR5 high level(2.5/2.2V)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOW</name>
                           <description>BOR5 low level(2.1/1.8V)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LDO3_PD</name>
                     <bitRange>[17:17]</bitRange>
                     <description>LDO3 power down switch bit(=1 power on, =0 power off)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>power off</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>power on</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
