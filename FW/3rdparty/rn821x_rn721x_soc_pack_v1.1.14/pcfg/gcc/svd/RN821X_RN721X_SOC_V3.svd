                     <description>data width selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>8BIT</name>
                           <description>select data width as 8 bit</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16BIT</name>
                           <description>select data width as 16 bit</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32BIT</name>
                           <description>select data width as 32 bit</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CLKDIV</name>
                     <access>read-write</access>
                     <bitRange>[19:12]</bitRange>
                     <description>clock divisor for SCK.frequency of SCK is (frequency of system clock)/(2*(CLKDIV+1))</description>
                  </field>
                  <field>
                     <name>TX_DFLT_EN</name>
                     <access>read-write</access>
                     <bitRange>[22:22]</bitRange>
                     <description>transmit data when TX buffer empty</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DFLT</name>
                           <description>transmit SPI_TXDFLT reg data when transmit buffer empty</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LAST</name>
                           <description>transmit last time reg data of SPI_TXDATA  when transmit buffer empty</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXEMPT_IRQEN</name>
                     <access>read-write</access>
                     <bitRange>[23:23]</bitRange>
                     <description>transmit empty interrupt</description>
                  </field>
                  <field>
                     <name>SCSN_NEG_IRQEN</name>
                     <access>read-write</access>
                     <bitRange>[24:24]</bitRange>
                     <description>CSN NEG interrupt</description>
                  </field>
                  <field>
                     <name>SCSN_POS_IRQEN</name>
                     <access>read-write</access>
                     <bitRange>[25:25]</bitRange>
                     <description>CSN POS interrupt</description>
                  </field>
                  <field>
                     <name>SLV_TX_ADV</name>
                     <access>read-write</access>
                     <bitRange>[26:26]</bitRange>
                     <description>SPI slave high speed mode enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LM</name>
                           <description>select SPI as slave low speed mode if device configrate as slave</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HM</name>
                           <description>select SPI as slave high speed mode if device configrate as slave</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>SPI status register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TRIF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>transmit interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>ERRIF</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>SCSN error interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RXCOLIF</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>receive data overflow interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TXCOLIF</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>transmit data overflow interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TXBUFVLD</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>transmit buffer not empty flag</description>
                  </field>
                  <field>
                     <name>TXEMPT</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>transmit buffer empty conflict flag (buffer empty but need to transmit)</description>
                  </field>
                  <field>
                     <name>SCSN_NEG</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>CSN posedge flag</description>
                  </field>
                  <field>
                     <name>SCSN_POS</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>CSN negedge flag</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TX</name>
               <description>SPI transmit data register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">TX</name>
                     <bitRange>[31:0]</bitRange>
                     <description>transmit data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RX</name>
               <description>SPI receive data register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">RX</name>
                     <bitRange>[31:0]</bitRange>
                     <description>receive data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXDFLT</name>
               <description>SPI tx default data register</description>
               <addressOffset>0x10</addressOffset>
