      <peripheral>
         <name>I2C</name>
         <description>I2C controller</description>
         <groupName>I2C</groupName>
         <baseAddress>0x40024000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x14</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>I2C control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>I2C module enable bit</description>
                  </field>
                  <field>
                     <name>BUSCON</name>
                     <access>read-write</access>
                     <bitRange>[2:1]</bitRange>
                     <description>I2C bus control bit (when finish command transmision clear automatically)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>no action</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>START</name>
                           <description>generate start sequence (clear automatically when finish command transmision)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>STOP</name>
                           <description>generate stop sequence  (clear automatically when finish command transmision)</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRQE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>I2C interrupt enable bit</description>
                  </field>
                  <field>
                     <name>ACK</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>ACK signal configuration bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ACK</name>
                           <description>receive 9st SCL generate ACK</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>receive 9st SCL donot generate ACK</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MODE</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>I2C slave/master mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>S</name>
                           <description>select as slave device</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>M</name>
                           <description>select as master device</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLK</name>
               <description>I2C clock configuration register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <resetValue>0x1</resetValue>
               <fields>
                  <field>
                     <name>CLKDIV</name>
                     <bitRange>[2:0]</bitRange>
                     <description>I2C module clock divisor selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DEFAULT</name>
                           <description>select I2C module clock divisor as 10</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7M4_FM</name>
                           <description>when system clock = 7.3728Mhz,  select I2C as fast speed mode, module clock set at system clock divided by 20</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7_FM</name>
                           <description>when system clock = 14.7456Mhz, select I2C as fast speed mode, module clock set at system clock divided by 38</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5_FM</name>
                           <description>when system clock = 29.4912Mhz, select I2C as fast speed mode, module clock set at system clock divided by 76</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1M8_SM</name>
                           <description>when system clock = 1.8432Mhz , select I2C as standard speed mode, module clock set at system clock divided by 20</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
