                           <description>power not ok</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OK</name>
                           <description>power ok</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BGROK</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>bgr power ok</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NULL</name>
                           <description>power not ok</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OK</name>
                           <description>power ok</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>LSCFG</name>
               <description>NV config</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>LSDC_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
