                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>RMS updated every 80ms</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>D2F0_CF_EN</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>SMM enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>DIS</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>EN</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>D2F1_CF_EN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>SMM enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>D2F1 pulse not output to io</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>D2F1 pulse output to io</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>LSDCOS</name>
               <description>NV measurement DC offset.</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">LSDCOS</name>
                     <bitRange>[23:0]</bitRange>
                     <description>NV measurement DC offset.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>LSTHO</name>
               <description>NV measurement threshold</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">LSTHO</name>
                     <bitRange>[23:0]</bitRange>
                     <description>NV measurement threshold</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>LSRMS</name>
               <description>IA cyclic updated NV measurement RMS</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">LSRMS</name>
                     <bitRange>[23:0]</bitRange>
                     <description>IA cyclic updated NV measurement RMS</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>LSRMS1</name>
               <description>IA RMS_L1 will not change after calculation</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">LSRMS1</name>
                     <bitRange>[23:0]</bitRange>
                     <description>IA RMS_L1 will not change after calculation</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>HFCONST</name>
               <description>HF const value</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">HFCONST</name>
                     <bitRange>[15:0]</bitRange>
                     <description>HF const value</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>D2FP0</name>
               <description>D2F power 0 vaule</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">D2FP0</name>
