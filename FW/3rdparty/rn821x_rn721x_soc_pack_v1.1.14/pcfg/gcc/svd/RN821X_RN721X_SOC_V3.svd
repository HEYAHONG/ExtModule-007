<?xml version="1.0" encoding="utf-8"?>
<device xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xsi:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_0.xsd">
   <name>RN821X_RN721X_SOC_V3</name>
   <version>v1.0.4</version>
   <description>Renergy Metering RN821X RN721X SOC</description>
   <addressUnitBits>8</addressUnitBits>
   <width>32</width>
   <cpu>
      <name>CM0</name>
      <revision>r0p0</revision>
      <endian>little</endian>
      <mpuPresent>false</mpuPresent>
      <fpuPresent>false</fpuPresent>
      <nvicPrioBits>3</nvicPrioBits>
      <vendorSystickConfig>false</vendorSystickConfig>
   </cpu>
   <size>32</size>
   <access>read-write</access>
   <resetValue>0</resetValue>
   <resetMask>0xFFFFFFFF</resetMask>
   <peripherals>
      <peripheral>
         <name>MADC</name>
         <description>analog peripherals</description>
         <groupName>ANALOG</groupName>
         <baseAddress>0x4002c000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x44</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>AD_CTRL</name>
               <description>SAR ADC control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>SAR_CH</name>
                     <bitRange>[2:0]</bitRange>
                     <description>SAR ADC channel selection bits(part1)</description>
                  </field>
                  <field>
                     <name>SAR_PGA</name>
                     <bitRange>[4:3]</bitRange>
                     <description>SAR ADC PGA selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0P5</name>
                           <description>select SAR ADC PGA as 0.5</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>select SAR ADC PGA as 1</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1P5</name>
                           <description>select SAR ADC PGA as 1.5</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>select SAR ADC PGA as 2</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>SAR_IE</name>
                     <bitRange>[5:5]</bitRange>
                     <description>SAR ADC interrupt enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>do not generate interrupt request on SAR event</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>generate interrupt request on SAR event</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SAR_CH3</name>
                     <bitRange>[6:6]</bitRange>
                     <description>SAR ADC channel selection bits(part2)</description>
                  </field>
                  <field>
                     <name>SAR_WAIT</name>
                     <bitRange>[11:7]</bitRange>
                     <description>set SAR ADC duration config bits((SAR_WAIT+1)*30.5us) between enable and sample</description>
                  </field>
                  <field>
                     <name>REF_WAIT</name>
                     <bitRange>[16:12]</bitRange>
                     <description>set voltage reference duration config bits((REF_WAIT+1)*30.5us) between REF enable and ADC enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_START</name>
               <description>SAR ADC start register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">AD_START</name>
                     <bitRange>[0:0]</bitRange>
                     <description>SAR ADC start control bit, =1 start sar-measure once</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_STAT</name>
               <description>SAR ADC status register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DREADY</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>SAR ADC data ready/pending flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PEND</name>
                           <description>SAR ADC data pending flag</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>READY</name>
                           <description>SAR ADC data ready flag</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TPS_BUSY</name>
                     <access>read-only</access>
                     <bitRange>[1:1]</bitRange>
                     <description>automatic temperature measurement busy flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <description>no outstanding automatic temperature measurement</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <description>pending automatic temperature measurement</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_DATA</name>
               <description>SAR ADC data register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">AD_DATA</name>
                     <bitRange>[9:0]</bitRange>
                     <description>SAR ADC result data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>LVD_CTRL</name>
               <description>LVD control register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>LVDS</name>
                     <bitRange>[3:0]</bitRange>
                     <description>LVD threshold voltage set bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2P3</name>
                           <description>select 2.3 as LVD Vil, 2.4 as LVD Vih</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P5</name>
                           <description>select 2.5 as LVD Vil, 2.6 as LVD Vih</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P7</name>
                           <description>select 2.7 as LVD Vil, 2.8 as LVD Vih</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P9</name>
                           <description>select 2.9 as LVD Vil, 3.0 as LVD Vih</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P1</name>
                           <description>select 3.1 as LVD Vil, 3.2 as LVD Vih</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P3</name>
                           <description>select 3.3 as LVD Vil, 3.4 as LVD Vih</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P5</name>
                           <description>select 3.5 as LVD Vil, 3.6 as LVD Vih</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P7</name>
                           <description>select 3.7 as LVD Vil, 3.8 as LVD Vih</description>
                           <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P9</name>
                           <description>select 3.9 as LVD Vil, 4.0 as LVD Vih</description>
                           <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4P0</name>
                           <description>select 4.0 as LVD Vil, 4.1 as LVD Vih</description>
                           <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4P2</name>
                           <description>select 4.2 as LVD Vil, 4.3 as LVD Vih</description>
                           <value>10</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4P4</name>
                           <description>select 4.4 as LVD Vil, 4.5 as LVD Vih</description>
                           <value>11</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4P6</name>
                           <description>select 4.6 as LVD Vil, 4.7 as LVD Vih</description>
                           <value>12</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4P7</name>
                           <description>select 4.7 as LVD Vil, 4.8 as LVD Vih</description>
                           <value>13</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVDIN</name>
                           <description>select 1.25 as LVD Vil, 1.45 as LVD Vih ,and compare with voltage found on LVDIN pin</description>
                           <value>14</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>LVDIE</name>
                     <bitRange>[5:5]</bitRange>
                     <description>LVD interrupt enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable interrupt</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable interrupt</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="LVDIE">
                     <name>CMP1IE</name>
                     <bitRange>[6:6]</bitRange>
                     <description>comparator No.1 interrupt enable bit</description>
                  </field>
                  <field derivedFrom="LVDIE">
                     <name>CMP2IE</name>
                     <bitRange>[7:7]</bitRange>
                     <description>comparator No.2 interrupt enable bit</description>
                  </field>
                  <field derivedFrom="LVDIE">
                     <name>SWHMIE</name>
                     <bitRange>[8:8]</bitRange>
                     <description>change to main power interrupt enable bit</description>
                  </field>
                  <field derivedFrom="LVDIE">
                     <name>SWHBIE</name>
                     <bitRange>[9:9]</bitRange>
                     <description>change to battery interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>LVD_STAT</name>
               <description>LVD status register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>LVDIF</name>
                     <access>read-only</access>
                     <bitRange>[0:0]</bitRange>
                     <description>LVD status flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>L</name>
                           <description>status flag, lower than threshold</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>H</name>
                           <description>status flag, higher than threshold</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="LVDIF">
                     <name>CMP1IF</name>
                     <access>read-only</access>
                     <bitRange>[1:1]</bitRange>
                     <description>comparator NO.1 status flag</description>
                  </field>
                  <field derivedFrom="LVDIF">
                     <name>CMP2IF</name>
                     <access>read-only</access>
                     <bitRange>[2:2]</bitRange>
                     <description>comparator No.2 status flag</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>LVDIIF</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>LVD interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>event not generated</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OCC</name>
                           <description>interrupt event generated</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="LVDIIF">
                     <name>CMP1IIF</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>comparator NO.1 interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="LVDIIF">
                     <name>CMP2IIF</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>comparator No.2 interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="LVDIIF">
                     <name>SWHMIF</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>change to main power interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="LVDIIF">
                     <name>SWHBIF</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>change to battery interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>SWHF</name>
                     <access>read-only</access>
                     <bitRange>[9:9]</bitRange>
                     <description>power change status bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>M</name>
                           <description>power selected as main power mode</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>B</name>
                           <description>power selected as battery mode</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_CTRL1</name>
               <description>SAR ADC control register 1</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>SAR_PGA</name>
                     <bitRange>[2:0]</bitRange>
                     <description>SAR ADC PGA config bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0P5</name>
                           <description>PGA select as 0.5</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1P0</name>
                           <description>PGA select as 1.0</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1P5</name>
                           <description>PGA select as 1.5</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P0</name>
                           <description>PGA select as 2.0</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0P25</name>
                           <description>PGA select as 0.25</description>
                           <value>4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SAR_PGA_SEL</name>
                     <bitRange>[3:3]</bitRange>
                     <description>SAR ADC PGA selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CTL_PGA</name>
                           <description>select AD_CTRL[4:3] PGA as PGA</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CTL1_PGA</name>
                           <description>select AD_CTRL1[2:0] PGA as PGA</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SAR_SAMPLE</name>
                     <bitRange>[6:4]</bitRange>
                     <description>SAR ADC simple clock numble bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1CLK</name>
                           <description>select as 1 clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2CLK</name>
                           <description>select as 2 clock</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3CLK</name>
                           <description>select as 3 clock</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4CLK</name>
                           <description>select as 4 clock</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>5CLK</name>
                           <description>select as 5 clock</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>6CLK</name>
                           <description>select as 6 clock</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7CLK</name>
                           <description>select as 7 clock</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8CLK</name>
                           <description>select as 8 clock</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SAR_CONVERT</name>
                     <bitRange>[14:8]</bitRange>
                     <description>SAR ADC simple to DOUT wait time config bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_DATA2</name>
               <description>SAR ADC data register 2</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">AD_DATA2</name>
                     <bitRange>[11:0]</bitRange>
                     <description>SAR ADC 12 bit result data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_CTRL3</name>
               <description>SAR ADC control register 3</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">AD_CTRL3</name>
                     <bitRange>[14:0]</bitRange>
                     <description>SAR ADC 12 bit result data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_DATA3</name>
               <description>SAR ADC data register 3</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">AD_DATA3</name>
                     <bitRange>[15:0]</bitRange>
                     <description>SAR ADC 12 bit result data bits</description>
                  </field>
               </fields>
            </register>
         </registers>
         <interrupt>
            <name>MADC</name>
            <value>5</value>
            <description>21 MADC or FLK(v2) Interrupt</description>
         </interrupt>
      </peripheral>
      <peripheral>
         <name>EMU</name>
         <description>energy metering unit</description>
         <groupName>METER</groupName>
         <baseAddress>0x50004000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x4d0</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>EMUCON</name>
               <description>Control</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>PRUN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>active power accumulation and PF pulse output</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>stop accumulating active power and outputing PF pulse</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>start accumulating active power and outputing PF pulse</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>QRUN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>reactive power accumulation and QF pulse output</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>stop accumulating reactive power and outputing QF pulse</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>start accumulating reactive power and outputing QF pulse</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SRUN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>reactive power accumulation and SF pulse output</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>stop accumulating reactive power and outputing SF pulse</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>start accumulating reactive power and outputing SF pulse</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CFSU</name>
                     <access>read-write</access>
                     <bitRange>[4:3]</bitRange>
                     <description>PF/QF output acceleration rate</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2</name>
                           <description>PF/QF output rate accelerated at x2</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>PF/QF output rate accelerated at x4</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8</name>
                           <description>PF/QF output rate accelerated at x8</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16</name>
                           <description>PF/QF output rate accelerated at x16</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CFSUEN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>PF/QF output acceleration enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>PF/QF output rate set as normal</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>accelerating PF/QF output rate defined as CFSU</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HPFUOFF</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>U-channel digital high-pass filters enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable DHPF in U-channel</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable DHPF in U-channel</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HPFIAOFF</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>IA-channel digital high-pass filters enable</description>
