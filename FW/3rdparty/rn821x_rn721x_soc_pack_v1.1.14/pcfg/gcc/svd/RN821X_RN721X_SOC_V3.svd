                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>REPETITIVE</name>
                           <description>SIMP_TC select as repetitive pulse mode</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRQEN</name>
                     <bitRange>[3:3]</bitRange>
                     <description>SIMP_TC interrupt enable bit</description>
                  </field>
               </fields>
            </register>
