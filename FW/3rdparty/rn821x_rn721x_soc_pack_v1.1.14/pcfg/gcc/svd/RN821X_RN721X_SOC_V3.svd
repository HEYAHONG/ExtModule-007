                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>FLASH mapped at address 0</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>FLASH mapped at address 1/2 (2nd FLASH at 0x0, 1st FLASH at 0x4000 and bootload at 0)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>FLASH switch mapping address with SRAM(FLASH at 0x10000000 and SRAM at 0)</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>BOOTROM mapped at address 0</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>FLASH mapped at address 1/2 total memory capacity</description>
                           <value>4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MOD0_EN</name>
               <description>module enable register No.0</description>
               <addressOffset>0x1C</addressOffset>
