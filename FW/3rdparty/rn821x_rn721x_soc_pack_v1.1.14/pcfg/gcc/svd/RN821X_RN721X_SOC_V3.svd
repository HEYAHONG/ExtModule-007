                     <name>DFTLVL</name>
                     <bitRange>[29:29]</bitRange>
                     <description>compare valid default level set bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>Interrupt enable register</description>
               <addressOffset>0x2C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>OVIE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>overflow interrupt enable</description>
                  </field>
                  <field>
                     <name>CC0IE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>compare(caputure) channel No.0 interrupt enable</description>
                  </field>
                  <field>
                     <name>CC1IE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>compare(caputure) channel No.1 interrupt enable</description>
                  </field>
                  <field>
                     <name>SLVIE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>slave interrupt enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>status register</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>OVF</name>
                     <bitRange>[0:0]</bitRange>
                     <description>overflow interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CC0F</name>
                     <bitRange>[1:1]</bitRange>
                     <description>compare(capture) channel No.0 flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CC1F</name>
                     <bitRange>[2:2]</bitRange>
                     <description>compare(capture) channel No.1 flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>SLVF</name>
                     <bitRange>[3:3]</bitRange>
                     <description>slave event flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>PWM_CFG</name>
               <description>PWM config register</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>DONEIE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>PWM output done interrupt enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="DONEIE">
                     <name>DATERRIE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>data error interrupt enable bit</description>
                  </field>
                  <field derivedFrom="DONEIE">
                     <name>BUFVLDIE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>PWM buffer empty interrupt enable bit (only soft mode available)</description>
                  </field>
                  <field derivedFrom="DONEIE">
                     <name>CYCDONEIE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>output cycle done interrupt enable bit</description>
                  </field>
                  <field>
                     <name>CMS</name>
                     <bitRange>[4:4]</bitRange>
                     <description>PWM control mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DMA</name>
                           <description>select as DMA mode</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SOFT</name>
                           <description>select as soft control mode</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CSS</name>
                     <bitRange>[5:5]</bitRange>
                     <description>PWM complete signal selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CS</name>
                           <description>select to finish output last complete signal while module disabled</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BS</name>
                           <description>select to break output signal while module disabled</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ORV</name>
                     <bitRange>[6:6]</bitRange>
                     <description>PWM output remain period mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>WLC</name>
                           <description>wave length configurable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ORV</name>
                           <description>output remain valid</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WL</name>
                     <bitRange>[16:7]</bitRange>
                     <description>PWM wave length config bits (available when ORV=0)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PWM_CTRL</name>
               <description>PWM control register</description>
               <addressOffset>0x38</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>PWM enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PWM_STA</name>
               <description>PWM status register</description>
               <addressOffset>0x3C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>BUSY</name>
                     <bitRange>[0:0]</bitRange>
                     <description>PWM output busy flag</description>
                  </field>
                  <field>
                     <name>DONE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>PWM output done interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>DATERR</name>
                     <bitRange>[2:2]</bitRange>
                     <description>PWM data error interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUFVLD</name>
                     <bitRange>[3:3]</bitRange>
                     <description>PWM buffer empty interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CYCDONE</name>
                     <bitRange>[4:4]</bitRange>
                     <description>PWM output cycle done interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>PWM_CNT</name>
               <description>PWM current counting value register</description>
               <addressOffset>0x40</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>N_PWM</name>
                     <bitRange>[15:0]</bitRange>
                     <description>PWM cycle Timer counter value bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PWM_DMA_BADR</name>
               <description>PWM DMA base address register</description>
               <addressOffset>0x44</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>BADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>DMA begin addr configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PWM_DMA_LEN</name>
               <description>PWM DMA length register</description>
               <addressOffset>0x48</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>LEN</name>
                     <bitRange>[14:0]</bitRange>
                     <description>DMA length configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PWM_DMA_ADR</name>
               <description>PWM DMA current address register</description>
               <addressOffset>0x4C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>ADR</name>
                     <bitRange>[14:0]</bitRange>
                     <description>current DMA addr bits</description>
                  </field>
               </fields>
            </register>
         </registers>
         <interrupt>
            <name>TC1</name>
            <value>15</value>
            <description>31 Timer/Counter 1 Interrupt</description>
         </interrupt>
      </peripheral>
      <peripheral>
         <name>UART0</name>
         <description>UART tranceiver</description>
         <groupName>UART</groupName>
         <baseAddress>0x40000000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x6C</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>UART control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>UART module enable bit</description>
                  </field>
                  <field>
                     <name>TXIE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>transmit interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RXIE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>receive interrupt enable bit</description>
                  </field>
                  <field>
                     <name>ERRIE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>error interrupt enable bit</description>
                  </field>
                  <field>
                     <name>STOPS</name>
                     <bitRange>[4:4]</bitRange>
                     <description>stop bits width selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2BIT</name>
                           <description>stop bit_width select as 2 bit</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1BIT</name>
                           <description>stop bit_width select as 1 bit</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATLEN</name>
                     <bitRange>[6:5]</bitRange>
                     <description>data length of frame format Configuration bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>5</name>
                           <description>select 5 bits of data field</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>6</name>
                           <description>select 6 bits of data field</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7</name>
                           <description>select 7 bits of data field</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8</name>
                           <description>select 8 bits of data field</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PARS</name>
                     <bitRange>[9:7]</bitRange>
                     <description>parity type selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>parity type select no parity</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ODD</name>
                           <description>parity type select odd parity</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EVEN</name>
                           <description>parity type select even parity</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0</name>
                           <description>parity type select stick_zero parity</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>parity type select stick one parity</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>USER</name>
                           <description>parity type select user_defined parity</description>
                           <value>5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRE</name>
                     <bitRange>[10:10]</bitRange>
                     <description>infra-red modulation enable bit</description>
                  </field>
                  <field>
                     <name>ILBE</name>
                     <bitRange>[11:11]</bitRange>
                     <description>inner loopback enable bit</description>
                  </field>
                  <field>
                     <name>IRSEL</name>
                     <bitRange>[12:12]</bitRange>
                     <description>infra-red modulation polarity selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>P</name>
                           <description>positive polarity. default driving voltage is high</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>N</name>
                           <description>negative polarity. default driving voltage is low</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LMSB</name>
                     <bitRange>[13:13]</bitRange>
                     <description>LSB/MSB transfer mode selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>L</name>
                           <description>LSB first transfer mode</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>M</name>
                           <description>MSB first transfer mode</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NEG</name>
                     <bitRange>[14:14]</bitRange>
                     <description>UART transfer polarity selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>P</name>
                           <description>positive polarity (default driving voltage is high)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>N</name>
                           <description>negative polarity (default driving voltage is low)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>BAUD</name>
               <description>UART baud rate configuration register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CLKDIV</name>
                     <bitRange>[12:0]</bitRange>
                     <description>baud rate configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>UART status register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>RX</name>
                     <bitRange>[0:0]</bitRange>
                     <description>receive finish flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX</name>
                     <bitRange>[1:1]</bitRange>
                     <description>transmit finish flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>PE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>parity error flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>OE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>overflow error flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>FE</name>
                     <bitRange>[4:4]</bitRange>
                     <description>frame error flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>DE</name>
                     <bitRange>[5:5]</bitRange>
                     <description>data error flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RB</name>
                     <bitRange>[6:6]</bitRange>
                     <description>receive busy flag</description>
                  </field>
                  <field>
                     <name>TB</name>
                     <bitRange>[7:7]</bitRange>
                     <description>transmit busy  flag</description>
                  </field>
                  <field>
                     <name>TX_FIFO_EMPTY</name>
                     <bitRange>[8:8]</bitRange>
                     <description>transmit fifo empty flag</description>
                  </field>
                  <field>
                     <name>TX_FIFO_FULL</name>
                     <bitRange>[9:9]</bitRange>
                     <description>transmit fifo full flag</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXD</name>
               <description>UART transmit data register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TXDATA</name>
                     <bitRange>[7:0]</bitRange>
                     <description>Transmit data value</description>
                  </field>
                  <field>
                     <name>UP</name>
                     <bitRange>[8:8]</bitRange>
                     <description>User-defined parity bit(valid when user-defined parity selected)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXD</name>
               <description>UART receive data register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>RXDATA</name>
                     <access>read-only</access>
                     <bitRange>[7:0]</bitRange>
                     <description>Received data value bits</description>
                  </field>
                  <field>
                     <name>UP</name>
                     <access>read-only</access>
                     <bitRange>[8:8]</bitRange>
                     <description>user-defined parity bit(valid when user-defined parity selected)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FDIV</name>
               <description>baud rate fractional part</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">FDIV</name>
                     <bitRange>[13:0]</bitRange>
                     <description>baud rate fractional divisor configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_CTRL</name>
               <description>UART DMA control register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_DMA_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
