                        <enumeratedValue>
                           <name>RCH</name>
                           <description>select RCH  as reference clock</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PLL</name>
                           <description>select PLL as reference clock</description>
                           <value>3</value>
