                     <name>I2C_RST_REQ</name>
                     <access>read-write</access>
                     <bitRange>[20:20]</bitRange>
                     <description>I2C module soft reset cfg bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MAP_CTRL</name>
               <description>system control register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>REMAP</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
