      <peripheral>
         <name>SPI1</name>
         <description>synchronous peripheral interface</description>
         <groupName>SPI</groupName>
         <baseAddress>0x40050000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x38</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>SPI control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>module enable</description>
                  </field>
                  <field>
                     <name>MAST_SLAV</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>master slave selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>M</name>
                           <description>select as master device</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>S</name>
                           <description>select as slave device</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TR_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
