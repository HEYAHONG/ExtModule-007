                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SMALL</name>
                           <description>reactive power less than starting power</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
