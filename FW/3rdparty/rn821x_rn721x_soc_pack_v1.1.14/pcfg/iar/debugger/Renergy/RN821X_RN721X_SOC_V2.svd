                  <field>
                     <name>OVLD</name>
                     <bitRange>[7:4]</bitRange>
                     <description>output Data valid byte configuration bits</description>
                  </field>
                  <field>
                     <name>ORV_EN</name>
                     <bitRange>[8:8]</bitRange>
                     <description>byte order reverse enable bit</description>
                  </field>
                  <field>
                     <name>DUMMY_EN</name>
                     <bitRange>[9:9]</bitRange>
                     <description>dummy byte enable bit</description>
                  </field>
                  <field>
                     <name>ADDR_RVEN</name>
                     <bitRange>[10:10]</bitRange>
                     <description>address order reverse enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTL</name>
               <description>M2M control register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>M2M_EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>M2M enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DUMMY</name>
               <description>M2M dummy register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DUMMY</name>
                     <bitRange>[31:0]</bitRange>
                     <description>M2M dummy register bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SADDR</name>
               <description>M2M source address register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">SADDR</name>
                     <bitRange>[16:0]</bitRange>
                     <description>M2M source address register bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DADDR</name>
               <description>M2M destination address register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DADDR</name>
                     <bitRange>[16:0]</bitRange>
                     <description>M2M done interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ILEN</name>
               <description>M2M length register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">ILEN</name>
                     <bitRange>[16:0]</bitRange>
                     <description>M2M input length configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>M2M interrupt enable register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">IE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>M2M interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>M2M interrupt flag register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">IF</name>
                     <bitRange>[0:0]</bitRange>
                     <description>M2M interrupt flag</description>
                  </field>
               </fields>
            </register>
         </registers>
         <interrupt>
            <name>EXT5</name>
            <value>29</value>
            <description>45 Extern5 Interrupt  (v2 share with M2M)</description>
         </interrupt>
      </peripheral>
      <peripheral>
         <name>NVM</name>
