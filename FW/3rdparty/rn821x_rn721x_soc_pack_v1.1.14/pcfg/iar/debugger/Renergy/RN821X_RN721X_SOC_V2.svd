                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NULS</name>
                           <description>when parity error, set RX_PAR_ERR flag but do not return error signal</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SEND</name>
                           <description>when parity error, set RX_PAR_ERR flag and return error signal by T=0 protocol</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REP_CNT</name>
                     <access>read-write</access>
                     <bitRange>[16:14]</bitRange>
                     <description>retry times when parity error found</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>do not resend when receive parity error</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>resend 1 time  when receive parity error</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>resend 2 times when receive parity error</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>resend 3 times when receive parity error</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>resend 4 times when receive parity error</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>5</name>
                           <description>resend 5 times when receive parity error</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>6</name>
                           <description>resend 6 times when receive parity error</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7</name>
                           <description>resend 7 times when receive parity error</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EGT</name>
                     <access>read-write</access>
                     <bitRange>[24:17]</bitRange>
                     <description>EGT width selection (in etu)</description>
