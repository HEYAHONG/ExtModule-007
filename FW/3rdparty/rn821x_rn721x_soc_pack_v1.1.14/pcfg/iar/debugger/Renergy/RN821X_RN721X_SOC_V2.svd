                        </enumeratedValue>
                        <enumeratedValue>
                           <name>M</name>
                           <description>MSB first transfer mode</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NEG</name>
