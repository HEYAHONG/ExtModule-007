                  <field>
                     <name>ERR_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>SCSN error interrupt enable</description>
                  </field>
                  <field>
                     <name>RXCOL_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>receive data collision interrupt enable</description>
                  </field>
                  <field>
                     <name>TXCOL_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>transmit data collision interrupt enable</description>
                  </field>
                  <field>
                     <name>LMSB</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>LSB or MSB selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MSB</name>
                           <description>MSB transmitted first</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LSB</name>
                           <description>LSB transmitted first</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CPOL</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>clock polarity selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EL</name>
                           <description>select low level for 'SCK' empty status</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EH</name>
                           <description>select high level for 'SCK' empty status</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CPHA</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>clock phase selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SAMP</name>
                           <description>leading edge sampling data, trailing edge build data</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BUILD</name>
                           <description>leading edge build data,  trailing edge sampling data</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SCSN_EN</name>
                     <access>read-write</access>
                     <bitRange>[9:9]</bitRange>
                     <description>SCSN error detection enable.applicable in master mode</description>
                  </field>
                  <field>
                     <name>WIDTH</name>
                     <access>read-write</access>
                     <bitRange>[11:10]</bitRange>
                     <description>data width selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>8BIT</name>
                           <description>select data width as 8 bit</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16BIT</name>
                           <description>select data width as 16 bit</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32BIT</name>
                           <description>select data width as 32 bit</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CLKDIV</name>
                     <access>read-write</access>
                     <bitRange>[19:12]</bitRange>
                     <description>clock divisor for SCK.frequency of SCK is (frequency of system clock)/(2*(CLKDIV+1))</description>
                  </field>
                  <field>
                     <name>TX_DFLT_EN</name>
                     <access>read-write</access>
                     <bitRange>[22:22]</bitRange>
                     <description>transmit data when TX buffer empty</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DFLT</name>
                           <description>transmit SPI_TXDFLT reg data when transmit buffer empty</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LAST</name>
                           <description>transmit last time reg data of SPI_TXDATA  when transmit buffer empty</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXEMPT_IRQEN</name>
                     <access>read-write</access>
                     <bitRange>[23:23]</bitRange>
                     <description>transmit empty interrupt</description>
                  </field>
                  <field>
                     <name>SCSN_NEG_IRQEN</name>
                     <access>read-write</access>
                     <bitRange>[24:24]</bitRange>
                     <description>CSN NEG interrupt</description>
                  </field>
                  <field>
                     <name>SCSN_POS_IRQEN</name>
                     <access>read-write</access>
                     <bitRange>[25:25]</bitRange>
                     <description>CSN POS interrupt</description>
                  </field>
                  <field>
                     <name>SLV_TX_ADV</name>
                     <access>read-write</access>
                     <bitRange>[26:26]</bitRange>
                     <description>SPI slave high speed mode enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LM</name>
                           <description>select SPI as slave low speed mode if device configrate as slave</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HM</name>
                           <description>select SPI as slave high speed mode if device configrate as slave</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>SPI status register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TRIF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
