            <register>
               <name>CTRL</name>
               <description>LCD control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>LCD module enable/disable bit</description>
                  </field>
                  <field>
                     <name>DUTY</name>
                     <bitRange>[3:1]</bitRange>
                     <description>LCD duty cycle selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>STA</name>
                           <description>static output (COM0)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_2</name>
                           <description>duty cycle = 1/2 (COM0~1)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_3</name>
                           <description>duty cycle = 1/3 (COM0~2)</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_4</name>
                           <description>duty cycle = 1/4 (COM0~3)</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_6</name>
                           <description>duty cycle = 1/6 (COM0~5)</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_8</name>
                           <description>duty cycle = 1/8 (COM0~7)</description>
                           <value>5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BIAS</name>
                     <bitRange>[4:4]</bitRange>
                     <description>LCD voltage bias control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1_3</name>
                           <description>select LCD bias as 1/3 voltage bias</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_4</name>
                           <description>select LCD bias as 1/3 voltage bias</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BIASLVL</name>
                     <bitRange>[10:5]</bitRange>
                     <description>LCD voltage Bias configuration bits</description>
                  </field>
                  <field>
                     <name>TYPE</name>
                     <bitRange>[11:11]</bitRange>
                     <description>LCD drive type selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>A</name>
                           <description>select LCD drive type A as LCD drive type</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>B</name>
                           <description>select LCD drive type B as LCD drive type</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PWD_PUMP</name>
                     <bitRange>[12:12]</bitRange>
                     <description>LCD PUMP disable/enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>LCD PUMP enable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>LCD PUMP disable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>LCD status register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DON</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Display On Pending Bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>LCD Display On did not occured</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OCC</name>
                           <description>LCD Display On occured</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DOFF</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Display Off Pending Bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>LCD Display Off did not occured</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OCC</name>
                           <description>LCD Display Off occured</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRQONEN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Display On IRQ Enble Bit</description>
                  </field>
                  <field>
                     <name>IRQOFFEN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Display Off IRQ Enble Bit</description>
                  </field>
                  <field>
                     <name>LCD_BUSY</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>LCD Busy Bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLKDIV</name>
               <description>LCD clock divisor register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CLKDIV</name>
                     <bitRange>[7:0]</bitRange>
                     <description>LCD clock divisor configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>BLINK</name>
               <description>LCD blink control register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TON</name>
                     <access>read-write</access>
                     <bitRange>[8:0]</bitRange>
                     <description>blink on duration configuration bits</description>
                  </field>
                  <field>
                     <name>TOFF</name>
                     <access>read-write</access>
                     <bitRange>[17:9]</bitRange>
                     <description>blink off duration configuration bits</description>
                  </field>
                  <field>
                     <name>BLINK_TIME</name>
                     <access>read-write</access>
                     <bitRange>[25:18]</bitRange>
                     <description>blink duration configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PS</name>
               <description>LCD PUMP set-up duration register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">PS</name>
                     <bitRange>[15:0]</bitRange>
                     <description>PUMP Set-up duration configuration bits,duration equal to 30.5us * (4 + PS)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RESCTL</name>
               <description>LCD internal resistance control register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>IRSN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>resistance divider mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IR</name>
                           <description>select internal resistance divider mode</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RSM</name>
                     <bitRange>[1:1]</bitRange>
                     <description>internal resistance divider mode signal selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SO</name>
                           <description>20k resistor time sharing connected, 200k resistor short circuited</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SL</name>
                           <description>time sharing switching between 20k resistor and 200k resistor</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RES_FT</name>
                     <bitRange>[3:2]</bitRange>
                     <description>resistance divider mode driving times(one screen refresh cycle) configuration bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1</name>
                           <description>driving once per cycle</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>driving 2 times per cycle</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>driving 3 times per cycle</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>driving 4 times per cycle</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RES_DT</name>
                     <bitRange>[6:4]</bitRange>
                     <description>resistance divider mode driving time (one screen refresh cycle) configuration bits</description>
                  </field>
                  <field>
                     <name>RES_AO</name>
                     <bitRange>[7:7]</bitRange>
                     <description>resistance divider mode driver control switch</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>resistors is driven time-sharing</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>resistors is always driven</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FCC</name>
                     <bitRange>[8:8]</bitRange>
                     <description>fast charging control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>Turn off fast charging function</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>Turn on fast charging function</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LDOS</name>
                     <bitRange>[12:9]</bitRange>
                     <description>LDO output level selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2P7</name>
                           <description>select LDO 2.7 v as output level</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P76</name>
                           <description>select LDO 2.76v as output level</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P82</name>
                           <description>select LDO 2.82v as output level</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P88</name>
                           <description>select LDO 2.88v as output level</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P94</name>
                           <description>select LDO 2.94v as output level</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P0</name>
                           <description>select LDO 3.0v  as output level</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P06</name>
                           <description>select LDO 3.06v as output level</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P12</name>
                           <description>select LDO 3.12v as output level</description>
                           <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P18</name>
                           <description>select LDO 3.18v as output level</description>
                           <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P24</name>
                           <description>select LDO 3.24v as output level</description>
                           <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P3</name>
                           <description>select LDO 3.3v  as output level</description>
                           <value>10</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P36</name>
                           <description>select LDO 3.36v as output level</description>
                           <value>11</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P42</name>
                           <description>select LDO 3.42v as output level</description>
                           <value>12</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P48</name>
                           <description>select LDO 3.48v as output level</description>
                           <value>13</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P54</name>
                           <description>select LDO 3.54v as output level</description>
                           <value>14</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P6</name>
                           <description>select LDO 3.6v  as output level</description>
                           <value>15</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
