                     <description>SAR ADC 12 bit result data bits</description>
                  </field>
               </fields>
            </register>
         </registers>
         <interrupt>
            <name>MADC</name>
            <value>5</value>
            <description>21 MADC or FLK(v2) Interrupt</description>
         </interrupt>
      </peripheral>
      <peripheral>
         <name>CRC</name>
         <description>crc calibration module</description>
         <baseAddress>0x40074000</baseAddress>
         <addressBlock>
            <offset>0</offset>
