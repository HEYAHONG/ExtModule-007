                  <field derivedFrom="DMA_CH0_PRI">
                     <name>DMA_CH8_PRI</name>
                     <access>read-write</access>
                     <bitRange>[17:16]</bitRange>
                     <description>DMA CH8: UART2 priority setting bits</description>
                  </field>
                  <field derivedFrom="DMA_CH0_PRI">
                     <name>DMA_CH9_PRI</name>
                     <access>read-write</access>
                     <bitRange>[19:18]</bitRange>
                     <description>DMA CH9: UART3 priority setting bits</description>
                  </field>
                  <field derivedFrom="DMA_CH0_PRI">
                     <name>DMA_CH10_PRI</name>
                     <access>read-write</access>
                     <bitRange>[21:20]</bitRange>
                     <description>DMA CH10: UART4 priority setting bits</description>
                  </field>
                  <field derivedFrom="DMA_CH0_PRI">
                     <name>DMA_CH11_PRI</name>
                     <access>read-write</access>
                     <bitRange>[23:22]</bitRange>
                     <description>DMA CH11: UART5 priority setting bits</description>
                  </field>
                  <field derivedFrom="DMA_CH0_PRI">
                     <name>DMA_CH12_PRI</name>
                     <access>read-write</access>
                     <bitRange>[25:24]</bitRange>
                     <description>DMA CH12: CAN priority setting bits</description>
                  </field>
                  <field derivedFrom="DMA_CH0_PRI">
                     <name>DMA_CH13_PRI</name>
                     <access>read-write</access>
                     <bitRange>[27:26]</bitRange>
                     <description>DMA CH13: TC1 priority setting bits</description>
                  </field>
                  <field>
                     <name>WKEY</name>
                     <access>read-write</access>
                     <bitRange>[31:28]</bitRange>
                     <description>write key (0xE)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FAB_UID0</name>
               <description>chip UID register No.0</description>
               <addressOffset>0xF0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">FAB_UID0</name>
                     <bitRange>[31:0]</bitRange>
                     <description>chip UID register No.0 bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FAB_UID1</name>
               <description>chip UID register No.1</description>
               <addressOffset>0xF4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">FAB_UID1</name>
                     <bitRange>[31:0]</bitRange>
                     <description>chip UID register No.1 bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_PRI2</name>
               <description>DMA priority config register No.2</description>
               <addressOffset>0xFC</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>DMA_CH14_PRI</name>
                     <access>read-write</access>
                     <bitRange>[1:0]</bitRange>
                     <description>DMA CH14: DSP priority setting bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HIGHEST</name>
                           <description>DMA highest priority</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <description>DMA high priority</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOW</name>
                           <description>DMA low priority</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOWEST</name>
                           <description>DMA lowest priority</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="DMA_CH14_PRI">
                     <name>DMA_CH15_PRI</name>
                     <access>read-write</access>
                     <bitRange>[3:2]</bitRange>
                     <description>DMA CH15: CRC priority setting bits</description>
                  </field>
                  <field derivedFrom="DMA_CH14_PRI">
                     <name>DMA_CH16_PRI</name>
                     <access>read-write</access>
                     <bitRange>[5:4]</bitRange>
                     <description>DMA CH16: M2M priority setting bits</description>
                  </field>
                  <field derivedFrom="DMA_CH14_PRI">
                     <name>DMA_CH17_PRI</name>
                     <access>read-write</access>
                     <bitRange>[7:6]</bitRange>
                     <description>DMA CH17: CPU priority setting bits</description>
                  </field>
                  <field>
                     <name>WKEY</name>
                     <access>read-write</access>
                     <bitRange>[31:28]</bitRange>
                     <description>write key (0xE)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ADCIN_CTRL</name>
               <description>ADCIN control register</description>
               <addressOffset>0x114</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>ADCIN_IA</name>
                     <bitRange>[0:0]</bitRange>
                     <description>IA channel ADCIN 1bit enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enble</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="ADCIN_IA">
                     <name>ADCIN_IB</name>
                     <bitRange>[1:1]</bitRange>
                     <description>IB channel ADCIN 1bit enable bit</description>
                  </field>
                  <field derivedFrom="ADCIN_IA">
                     <name>ADC_CLK_OEN</name>
                     <bitRange>[8:8]</bitRange>
                     <description>ADCIN clock output enable bit</description>
                  </field>
                  <field>
                     <name>ADC_CLKO_SEL</name>
                     <bitRange>[9:9]</bitRange>
                     <description>ADCIN clock freq selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1M8</name>
                           <description>freq select as 1.8432Mhz</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3M6</name>
                           <description>freq select as 3.6864Mhz</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYSCP_CON</name>
               <description>system chopped wave config register</description>
               <addressOffset>0x118</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>ADC_SYSCPIA_EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>IA channel syschop enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="ADC_SYSCPIA_EN">
                     <name>ADC_SYSCPIB_EN</name>
                     <bitRange>[1:1]</bitRange>
                     <description>IB channel syschop enable bit</description>
                  </field>
                  <field derivedFrom="ADC_SYSCPIA_EN">
                     <name>ADC_SYSCPU_EN</name>
                     <bitRange>[2:2]</bitRange>
                     <description>U channel syschop enable bit</description>
                  </field>
                  <field>
                     <name>ADC_SYSCP_MODE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>syschop mode selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>AUTO</name>
                           <description>select as auto mode</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MANU</name>
                           <description>select as manual mode</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ADC_SYSCP_SEL</name>
                     <bitRange>[5:4]</bitRange>
                     <description>forward and reverse sampling freq config bits (only available when adc_syscp_mode=0)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>N2048</name>
                           <description>N = 2048, period = (1.8432e6/N) Hz</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>N4096</name>
                           <description>N = 4096, period = (1.8432e6/N) Hz</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>N8192</name>
                           <description>N = 8192, period = (1.8432e6/N) Hz</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>N16384</name>
                           <description>N = 16384, period = (1.8432e6/N) Hz</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ADC_SYSCP_PH</name>
                     <bitRange>[8:8]</bitRange>
                     <description>forward and reverse sample cfg bit(only available when adc_syscp_mode=1)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>FS</name>
                           <description>select as forward sampling</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RS</name>
                           <description>select as reverse sampling</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
         <interrupt>
            <name>SYSCLKCAL</name>
            <value>0</value>
            <description>16 SYSCLK CALC or EMU_RCD(v2/v3) Interrupt</description>
         </interrupt>
      </peripheral>
      <peripheral>
         <name>TC0</name>
         <description>A 32-bit timer</description>
         <groupName>TIMER</groupName>
         <baseAddress>0x40010000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x34</size>
            <usage>registers</usage>
         </addressBlock>
         <resetValue>0</resetValue>
         <registers>
            <register>
               <name>CNT</name>
               <description>current counting value register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">CNT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>current Timer counter value bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PS</name>
               <description>prescaler value register of the counter clock</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">PS</name>
                     <bitRange>[15:0]</bitRange>
                     <description>prescaler value bits of the counter clock</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DN</name>
               <description>target counting value register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DN</name>
                     <bitRange>[31:0]</bitRange>
                     <description>target counting value bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCD0</name>
               <description>capture(compare) channel No.0 data register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CCD0</name>
                     <bitRange>[31:0]</bitRange>
                     <description>capture(compare) channel No.0 data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCD1</name>
               <description>capture(compare) channel No.1 data register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CCD1</name>
                     <bitRange>[31:0]</bitRange>
                     <description>capture(compare) channel No.1 data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCFG</name>
               <description>clock config register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CM</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>clock mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INT</name>
                           <description>using on-chip system clock as input counting clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXT</name>
                           <description>using external clock(to the timer) as input counting clock(refer to bitfield CS of register TC_CCFG for clock selection)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLTEN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>external clock source filter enable bit</description>
                  </field>
                  <field>
                     <name>CS</name>
                     <access>read-write</access>
                     <bitRange>[12:8]</bitRange>
                     <description>external clock source selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>UART0_RXD</name>
                           <description>select UART0 RXD</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART1_RXD</name>
                           <description>select UART1 RXD</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART2_RXD</name>
                           <description>select UART2 RXD</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART3_RXD</name>
                           <description>select UART3 RXD</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OTHTC_OUTN0</name>
                           <description>select negative output of channel 0 of the other TC (TC1/TC0)</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OTHTC_OUTP0</name>
                           <description>select positive output of channel 0 of the other TC (TC1/TC0)</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OTHTC_OUTN1</name>
                           <description>select negative output of channel 1 of the other TC (TC1/TC0)</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OTHTC_OUTP1</name>
                           <description>select positive output of channel 1 of the other TC (TC1/TC0)</description>
                           <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART4_RXD</name>
                           <description>select UART4_RXD</description>
                           <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART5_RXD</name>
                           <description>select UART5_RXD</description>
                           <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>78160_P41</name>
                           <description>select iso7816 channel No.0 input(P41)</description>
                           <value>10</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>78161_P42</name>
                           <description>select iso7816 channel No.1 dual-direction input(P42)</description>
                           <value>11</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>78161_P43</name>
                           <description>select iso7816 channel No.1 single-direction input(P43)</description>
                           <value>12</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SF_OUT</name>
                           <description>select apparent power pulse output</description>
                           <value>16</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>QF_OUT</name>
                           <description>select reactive power pulse output</description>
                           <value>17</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PF_OUT</name>
                           <description>select active power pulse output</description>
                           <value>18</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTC_OUT</name>
                           <description>select rtc output</description>
                           <value>19</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P10</name>
                           <description>select P1[0]</description>
                           <value>20</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P11</name>
                           <description>select P1[1]</description>
                           <value>21</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P12_P52</name>
                           <description>select P1[2] or P5[2]</description>
                           <value>22</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P13_P53</name>
                           <description>select P1[3] or P5[3]</description>
                           <value>23</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P14_P54</name>
                           <description>select P1[4] or P5[4]</description>
                           <value>24</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P15_P55</name>
                           <description>select P1[5] or P5[5]</description>
                           <value>25</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P16_P56</name>
                           <description>select P1[6] or P5[6]</description>
                           <value>26</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P17_P57</name>
                           <description>select P1[7] or P5[7]</description>
                           <value>27</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P30</name>
                           <description>select P3[0]</description>
                           <value>28</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P31</name>
                           <description>select P3[1]</description>
                           <value>29</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P33</name>
                           <description>select P3[3]</description>
                           <value>30</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P35</name>
                           <description>select P3[5]</description>
                           <value>31</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ECLKMODE</name>
                     <access>read-write</access>
                     <bitRange>[14:13]</bitRange>
                     <description>external clock mode selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PE</name>
                           <description>every posedge found on input recognized as a couting event</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NE</name>
                           <description>every negedge found on input recognized as a couting event</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BE</name>
                           <description>both posedge and negedge found on input recognized as a as a couting event</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLTOPT</name>
                     <access>read-write</access>
                     <bitRange>[23:16]</bitRange>
                     <description>external clock source filter clock cycles set bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRL</name>
               <description>control register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>START</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>timer start bit</description>
                  </field>
                  <field>
                     <name>SLVEN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>slave mode enable</description>
                  </field>
                  <field>
                     <name>SLVFLTEN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>slave mode input filter enable</description>
                  </field>
                  <field>
                     <name>OPS</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>one pulse mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>one pulse mode disabled(timer continue counting when overflow)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>one pulse mode enabled(timer stop counting when overflow)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SLVCHANSSEL</name>
                     <access>read-write</access>
                     <bitRange>[9:5]</bitRange>
                     <description>slave mode input selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>UART0_RXD</name>
                           <description>select UART0 RXD</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART1_RXD</name>
                           <description>select UART1 RXD</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART2_RXD</name>
                           <description>select UART2 RXD</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART3_RXD</name>
                           <description>select UART3 RXD</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OTHTC_OUTN0</name>
                           <description>select negative output of channel 0 of the other TC (TC1/TC0)</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OTHTC_OUTP0</name>
                           <description>select positive output of channel 0 of the other TC (TC1/TC0)</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OTHTC_OUTN1</name>
                           <description>select negative output of channel 1 of the other TC (TC1/TC0)</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OTHTC_OUTP1</name>
                           <description>select positive output of channel 1 of the other TC (TC1/TC0)</description>
                           <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART4_RXD</name>
                           <description>select UART4_RXD</description>
                           <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART5_RXD</name>
                           <description>select UART5_RXD</description>
                           <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>78160_P41</name>
                           <description>select iso7816 channel No.0 input(P41)</description>
                           <value>10</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>78161_P42</name>
                           <description>select iso7816 channel No.1 dual-direction input(P42)</description>
                           <value>11</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>78161_P43</name>
                           <description>select iso7816 channel No.1 single-direction input(P43)</description>
