                  <field>
                     <name>IO_EN</name>
                     <access>read-write</access>
                     <bitRange>[25:25]</bitRange>
                     <description>input output enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1D</name>
                           <description>select as output only</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2D</name>
                           <description>select as bidirectional</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RX_GT</name>
                     <access>read-write</access>
                     <bitRange>[28:28]</bitRange>
                     <description>receive GT width</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2ETU</name>
                           <description>select receive data GT as 2etu</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1ETU</name>
                           <description>select receive data GT as 1etu</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OLD_EN</name>
                     <access>read-write</access>
                     <bitRange>[29:29]</bitRange>
                     <description>OLD detection enable</description>
                  </field>
                  <field>
                     <name>OLD_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[30:30]</bitRange>
                     <description>OLD detection interrupt enable</description>
                  </field>
                  <field>
                     <name>CARD_CHECK_EN</name>
                     <access>read-write</access>
                     <bitRange>[31:31]</bitRange>
                     <description>card draw detection enable.only when CARD_CHECK_EN and OLD_IRQ_EN enable at the same time ,CARD_OUT interrupt enable.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLK</name>
               <description>ISO7816 clock control register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DIV</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
                     <description>ISO7816 clock divisor selections bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>select system clock as iso7816 module clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>select system clock devided by 2   as iso7816 module clock</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>select system clock devided by 4   as iso7816 module clock</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8</name>
                           <description>select system clock devided by 8   as iso7816 module clock</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16</name>
                           <description>select system clock devided by 16  as iso7816 module clock</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32</name>
                           <description>select system clock devided by 32  as iso7816 module clock</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>64</name>
                           <description>select system clock devided by 64  as iso7816 module clock</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>128</name>
                           <description>select system clock devided by 128 as iso7816 module clock</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>O_EN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>card clock output enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>BDDIV0</name>
               <description>ISO7816 baudrate coefficients No.0 register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>FD</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>FI and DI of reset ACK response</description>
                  </field>
                  <field>
                     <name>FDS</name>
                     <access>read-write</access>
                     <bitRange>[20:8]</bitRange>
                     <description>baudrate coefficient.Only writtalbe when FSD0_EN=1.otherwise read as 372</description>
                  </field>
                  <field>
                     <name>FDS_EN</name>
                     <access>read-write</access>
                     <bitRange>[21:21]</bitRange>
                     <description>F/D config enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>FD</name>
                           <description>select reset input baud divisor (FD)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FDS</name>
                           <description>enable soft baud divisor (FDS)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>BDDIV1</name>
               <description>ISO7816 baudrate coefficients No.1 register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>FD</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>FI and DI of reset ACK response</description>
                  </field>
                  <field>
                     <name>FDS</name>
                     <access>read-write</access>
                     <bitRange>[20:8]</bitRange>
                     <description>baudrate coefficient.Only writtalbe when FSD0_EN=1.otherwise read as 372</description>
                  </field>
                  <field>
                     <name>FDS_EN</name>
                     <access>read-write</access>
                     <bitRange>[21:21]</bitRange>
                     <description>F/D config enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>FD</name>
                           <description>select reset input baud divisor (FD)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FDS</name>
                           <description>enable soft baud divisor (FDS)</description>
                           <value>1</value>
                        </enumeratedValue>
