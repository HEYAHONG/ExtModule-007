                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART2</name>
                           <description>P24(RX2) and P25(TX2) use as UART2, available when PCA3.PC245(PCA3[20]) = 0 and PCA0.SWD_SEL(PCA0[29]) =0</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
