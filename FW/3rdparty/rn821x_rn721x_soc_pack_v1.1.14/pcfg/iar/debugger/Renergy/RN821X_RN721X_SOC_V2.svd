                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P245</name>
                           <description>when PCA3.PC245(PCA3[20]) = 0, use P24 as SWDCLK and P25 as SWDIO</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>UART2_SEL</name>
                     <bitRange>[31:30]</bitRange>
                     <description>UART2 selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PC245</name>
                           <description>select P24/P25 as UART2, when P24/P25 PC245 properly cfg as UART2</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PC0_1</name>
                           <description>select P00/P01 as UART2, when P00/P01 PC00 PC01 properly cfg as UART2</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PC223</name>
                           <description>select P22/P23 as UART2, when P22/P23 PC223 properly cfg as UART2</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PC267</name>
                           <description>select P26/P27 as UART2, when P26/P27 PC267 properly cfg as UART2</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
