            <register>
               <name>EMUSTATUS2</name>
               <description>status</description>
               <addressOffset>0x188</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>REVP</name>
                     <access>read-only</access>
                     <bitRange>[0:0]</bitRange>
                     <description>indication of reverse active power.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>when the next detecting result is positive active power ,clear the bit as 0 .</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when negative active power is detected ,set the bit as 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REVQ</name>
                     <access>read-only</access>
                     <bitRange>[1:1]</bitRange>
                     <description>indication of reverse reactive power</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>when the next detecting result is positive reactive power ,clear the bit as 0 .</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when negative reactive power is detected ,set the bit as 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOPLD</name>
                     <access>read-only</access>
                     <bitRange>[2:2]</bitRange>
                     <description>active power and starting power status register</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>When active power is more than or equal to starting power ,Nopld is clear to 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when active power is less than starting power ,Nopld is set to 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOQLD</name>
                     <access>read-only</access>
                     <bitRange>[3:3]</bitRange>
                     <description>reactive power and starting power status register</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>When reactive power is more than or equal to starting power ,Noqld is clear to 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when reactive power is less than starting power ,Noqld is set to 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CHENSEL</name>
                     <access>read-only</access>
                     <bitRange>[4:4]</bitRange>
                     <description>indicaion of selected current channel.Default is 0.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>0:the current channel for caculating active/reactive energy is A.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>1:the current channel for caculating active/reactive energy is B.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WREN</name>
                     <access>read-only</access>
                     <bitRange>[5:5]</bitRange>
                     <description>write enable flag.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>0:disable to write the protected register.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>1:enable to write the protected register.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOSLD</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>apparent power adn starting power status register</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>When apparent power is more than or equal to starting power ,Nosld is clear to 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when apparent power is less than starting power ,Nosld is set to 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LDO_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[7:7]</bitRange>
                     <description>indicaion of LDO.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>0:LDO value is less than threshold voltage.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>1:LDO is normal.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>VREF_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[8:8]</bitRange>
                     <description>indicaion of Vref.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>0:Vref value is less than threshold voltage.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>1:Vref is normal.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REVP2</name>
                     <access>read-only</access>
                     <bitRange>[9:9]</bitRange>
                     <description>indication of reverse active power 2.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>when the next detecting result is positive active power ,clear the bit as 0 .</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when negative active power is detected ,set the bit as 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REVQ2</name>
                     <access>read-only</access>
                     <bitRange>[10:10]</bitRange>
                     <description>indication of reverse reactive power 2.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>when the next detecting result is positive reactive power ,clear the bit as 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when negative reactive power is detected ,set the bit as 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOP2LD</name>
                     <access>read-only</access>
                     <bitRange>[11:11]</bitRange>
                     <description>active power 2 and starting power status register</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>When active power 2 is more than or equal to starting power ,Nopld is clear to 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when active power 2 is less than starting power ,Nopld is set to 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOQ2LD</name>
                     <access>read-only</access>
                     <bitRange>[12:12]</bitRange>
                     <description>reactive power and starting power status register</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>When reactive power 2 is more than or equal to starting power ,Nopld is clear to 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when reactive power 2 is less than starting power ,Nopld is set to 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOS2LD</name>
                     <access>read-only</access>
                     <bitRange>[13:13]</bitRange>
                     <description>apparent power and starting power status register</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>When apparent power 2 is more than or equal to starting power ,Nosld is clear to 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>when apparent power 2 is less than starting power ,Nosld is set to 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
