         </addressBlock>
         <registers>
            <register>
               <name>MODE</name>
               <description>LPUART mode configuration register</description>
               <addressOffset>0x0</addressOffset>
               <access>read-write</access>
               <resetMask>0x0</resetMask>
               <fields>
                  <field>
                     <name>TE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>LPUART transmit enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>LPUART transmit disable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>LPUART transmit enable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>LPUART receive enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>LPUART receive disable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>LPUART receive enable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>infra-red modulation enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>infra-red modulation disable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>infra-red modulation enable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NEG</name>
                     <bitRange>[3:3]</bitRange>
                     <description>transfer polarity selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>P</name>
                           <description>positive polarity (default driving voltage is high)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>N</name>
                           <description>negative polarity (default driving voltage is low)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRPOL</name>
                     <bitRange>[4:4]</bitRange>
                     <description>infra-red modulation polarity selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>P</name>
                           <description>positive polarity (default driving voltage is high)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>N</name>
                           <description>negative polarity (default driving voltage is low)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATLEN</name>
                     <bitRange>[6:5]</bitRange>
