                           <description>float subtraction mode enable</description>
                           <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FP_MLAD</name>
                           <description>float multiplication and addition mode enable</description>
                           <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BTFY_ONCE</name>
                           <description>Butterfly operation unit one-shot mode enable</description>
                           <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BTFY_DMA</name>
                           <description>Butterfly operation unit DMA mode enable</description>
                           <value>10</value>
                        </enumeratedValue>
                        <enumeratedValue>
