               <description>crc xor output value register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">XOR</name>
                     <bitRange>[31:0]</bitRange>
