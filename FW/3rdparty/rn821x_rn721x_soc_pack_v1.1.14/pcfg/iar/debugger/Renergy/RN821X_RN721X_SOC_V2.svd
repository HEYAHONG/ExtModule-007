      <peripheral>
         <name>WDT</name>
         <description>watchdog timer</description>
         <groupName>WDT</groupName>
         <baseAddress>0x40030000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x20</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>EN</name>
               <description>Watchdog enable register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>WDTE</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>WDT enable bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RESTART</name>
                           <description>clear WDT counter and restart WDT(write value)</description>
                           <value>0xBB</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS_DFLT</name>
                           <description>WDTE default value</description>
