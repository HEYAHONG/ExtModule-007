               <fields>
                  <field>
                     <name fieldName="None">TXDFLT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>transmit default data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_CTRL</name>
               <description>SPI DMA control register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>TX_DMA_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>transmit DMA enable bit</description>
                  </field>
                  <field>
                     <name>RX_DMA_EN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>receive DMA enable bit</description>
                  </field>
                  <field>
                     <name>TX_CYC_MODE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>periodic transmit enable bit</description>
                  </field>
                  <field>
                     <name>RX_CYC_MODE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>periodic receive enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TBADR</name>
               <description>SPI DMA TX base address register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TBADR</name>
                     <bitRange>[16:0]</bitRange>
                     <description>DMA transmit begin addr configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RBADR</name>
               <description>SPI DMA RX base address register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RBADR</name>
                     <bitRange>[16:0]</bitRange>
                     <description>DMA receive  begin addr configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TLEN</name>
               <description>SPI DMA TX length register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TLEN</name>
                     <bitRange>[16:0]</bitRange>
                     <description>DMA transmit length configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RLEN</name>
               <description>SPI DMA RX length register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RLEN</name>
                     <bitRange>[16:0]</bitRange>
                     <description>DMA receive  length configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TADR</name>
               <description>SPI DMA TX current address register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TADR</name>
                     <bitRange>[16:0]</bitRange>
                     <description>current transmit DMA addr bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RADR</name>
               <description>SPI DMA RX current address register</description>
               <addressOffset>0x2C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RADR</name>
                     <bitRange>[16:0]</bitRange>
                     <description>current receive  DMA addr bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_IE</name>
               <description>SPI DMA interrupt enable register</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>TX_HIE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>DMA transmit half-full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>TX_FIE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA receive full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_HIE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>DMA transmit half-full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_FIE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>DMA receive full interrupt enable bit</description>
                  </field>
                  <field>
                     <name>TX_ERR_IE</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>DMA transmit error interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_ERR_IE</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>DMA receive error(data recover) interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_FLG</name>
               <description>SPI DMA interrupt flag register</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>TX_HDONE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>DMA transmit half-full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX_FDONE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA transmit full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_HDONE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>DMA receive half-full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_FDONE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>DMA receive full interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_ERR</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>DMA receive error interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
         </registers>
         <interrupt>
            <name>SPI0</name>
            <value>10</value>
            <description>26 SPI0(except v3) Interrupt</description>
         </interrupt>
      </peripheral>
      <peripheral derivedFrom="SPI0">
         <name>SPI1</name>
         <groupName>SPI</groupName>
         <baseAddress>0x40050000</baseAddress>
      </peripheral>
      <peripheral derivedFrom="SPI0">
         <name>SPI2</name>
         <groupName>SPI</groupName>
         <baseAddress>0x40054000</baseAddress>
      </peripheral>
      <peripheral derivedFrom="SPI0">
         <name>SPI3</name>
         <groupName>SPI</groupName>
         <baseAddress>0x40058000</baseAddress>
      </peripheral>
      <peripheral>
         <name>SYSCTL</name>
         <description>system control</description>
         <groupName>SYSTEM</groupName>
         <baseAddress>0x40034000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x11C</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>OSC_CTRL1</name>
               <description>system oscillator control register No.1</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>PLL_PD</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>PLL disable bit (=1 disable, =0 enable)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="PLL_PD">
                     <name>IRCH_PD</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>internal RCH oscillator disable bit (=1 disable, =0 enable)</description>
                  </field>
                  <field>
                     <name>PLL_HOSC_DIV</name>
                     <access>read-write</access>
                     <bitRange>[3:2]</bitRange>
                     <description>system clock division(applicable for high frequency mode(PLL or HOSC))</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIV1</name>
                           <description>when PLL/HOSC selected as system clock not divided</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV2</name>
                           <description>when PLL/HOSC selected as system clock divided by 2</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV4</name>
                           <description>when PLL/HOSC selected as system clock divided by 4</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV8</name>
                           <description>when PLL/HOSC selected as system clock divided by 8</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>LOSC_ON</name>
                     <access>read-only</access>
                     <bitRange>[4:4]</bitRange>
                     <description>system clock flag of losc or RCL</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>losc isn't used as system clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SYS_CLK</name>
                           <description>losc used as system clock</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>IRCH_ON</name>
                     <access>read-only</access>
                     <bitRange>[5:5]</bitRange>
                     <description>system clock flag of internal RC oscillator</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>IRCH isn't used as system clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SYS_CLK</name>
                           <description>IRCH used as system clock</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>PLL_HOSC_ON</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>system clock flag of external high-frequence oscillator or internal PLL</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>PLL_HOSC isn't used as system clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SYS_CLK</name>
                           <description>PLL_HOSC used as system clock</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>PLL_LOCK</name>
                     <access>read-only</access>
                     <bitRange>[7:7]</bitRange>
                     <description>PLL locked flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>PLL hasn't locked yet</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOCK</name>
                           <description>PLL locked</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SYSCLK_STAT</name>
                     <access>read-only</access>
                     <bitRange>[10:8]</bitRange>
                     <description>system clock freq status flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>7M4</name>
                           <description>current system clock freq = 7.3728MHz</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3M6</name>
                           <description>current system clock freq = 3.6864MHz</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1M8</name>
                           <description>current system clock freq = 1.8432MHz</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32K</name>
                           <description>current system clock freq = 32.768KHz</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7</name>
                           <description>current system clock freq = 14.7456Mhz</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5</name>
                           <description>current system clock freq = 29.4912Mhz</description>
                           <value>5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>LOSC_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[11:11]</bitRange>
                     <description>LOSC ON status flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>clock off</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>clock on</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="LOSC_CLOCK_FLAG">
                     <name>PLL_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[12:12]</bitRange>
                     <description>PLL ON status flag</description>
                  </field>
                  <field derivedFrom="LOSC_CLOCK_FLAG">
                     <name>RCH_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[13:13]</bitRange>
                     <description>internal RCH ON status flag</description>
                  </field>
                  <field derivedFrom="LOSC_CLOCK_FLAG">
                     <name>RCL_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[14:14]</bitRange>
                     <description>internal RCL ON status flag</description>
                  </field>
                  <field derivedFrom="LOSC_CLOCK_FLAG">
                     <name>HOSC_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[15:15]</bitRange>
                     <description>HOSC ON status flag</description>
                  </field>
                  <field derivedFrom="LOSC_CLOCK_FLAG">
                     <name>RCM_CLOCK_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[16:16]</bitRange>
                     <description>RCM ON status flag</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYS_MODE</name>
               <description>system mode control register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MODE</name>
                     <access>read-write</access>
                     <bitRange>[3:0]</bitRange>
                     <description>system clock configuration bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HCM</name>
                           <description>select HCM mode as system mode</description>
                           <value>13</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCM</name>
                           <description>select RCM mode as system mode</description>
                           <value>14</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LCM</name>
                           <description>select LCM mode as system mode</description>
                           <value>15</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>FLASH_BUSY</name>
                     <access>read-only</access>
                     <bitRange>[5:5]</bitRange>
                     <description>FLASH busy status flag (=1 busy, =0 idle)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <description>idle</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <description>idle</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYS_PD</name>
               <description>system power-down control register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>ADCI1_PD</name>
                     <bitRange>[0:0]</bitRange>
                     <description>I1 ADC power down switch bit(=1 power down, =0 power on)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>power on</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>power off</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>ADCI2_PD</name>
                     <bitRange>[1:1]</bitRange>
                     <description>I2 ADC power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>ADCU_PD</name>
                     <bitRange>[2:2]</bitRange>
                     <description>U ADC power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>LVD_PD</name>
                     <bitRange>[3:3]</bitRange>
                     <description>LVD power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>CMP1_PD</name>
                     <bitRange>[4:4]</bitRange>
                     <description>power down switch bit of Comparator No.1 (=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>CMP2_PD</name>
                     <bitRange>[5:5]</bitRange>
                     <description>power down switch bit of Comparator No.2 (=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>BGR_PD</name>
                     <bitRange>[6:6]</bitRange>
                     <description>BGR power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field derivedFrom="ADCI1_PD">
                     <name>BGRLP_PD</name>
                     <bitRange>[7:7]</bitRange>
                     <description>BGRLP power down switch bit(=1 power down, =0 power on)</description>
                  </field>
                  <field enums="ALL_ENUM">
                     <name>PWD_CMP1R</name>
                     <bitRange>[8:8]</bitRange>
                     <description>switch bit of CMP1 internal simpling resistor(=1 register off, =0 register on)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>switch on</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>switch off</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="PWD_CMP1R">
                     <name>PWD_CMP2R</name>
                     <bitRange>[9:9]</bitRange>
                     <description>switch bit of CMP2 internal simpling resistor(=1 register off, =0 register on)</description>
                  </field>
                  <field enums="ALL_ENUM">
                     <name>HYSEN_CMP1</name>
                     <bitRange>[10:10]</bitRange>
                     <description>CMP1 hysteresis switch bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>switch on</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>switch off</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="HYSEN_CMP1">
                     <name>HYSEN_CMP2</name>
                     <bitRange>[11:11]</bitRange>
                     <description>CMP2 hysteresis switch bit</description>
                  </field>
                  <field>
                     <name>VSEL_BOR5</name>
                     <bitRange>[16:16]</bitRange>
                     <description>BOR5 voltage threshold bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <description>BOR5 high level(2.5/2.2V)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOW</name>
                           <description>BOR5 low level(2.1/1.8V)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LDO3_PD</name>
                     <bitRange>[17:17]</bitRange>
                     <description>LDO3 power down switch bit(=1 power on, =0 power off)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>power off</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>power on</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>ADC_CTRL</name>
               <description>ADC control register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>ADCI1_PGA</name>
                     <bitRange>[2:0]</bitRange>
                     <description>ADC I1 PGA config bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1TIME</name>
                           <description>PGA config 1 time</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2TIME</name>
                           <description>PGA config 2 times</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8TIME</name>
                           <description>PGA config 8 times</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16TIME</name>
                           <description>PGA config 16 times</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="ALL_ENUM">
                     <name>ADCI2_PGA</name>
                     <bitRange>[5:3]</bitRange>
                     <description>ADC I2 PGA config bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1TIME</name>
                           <description>PGA config 1 time</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2TIME</name>
                           <description>PGA config 2 times</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4TIME</name>
                           <description>PGA config 4 times</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="ADCI2_PGA">
                     <name>ADCU_PGA</name>
                     <bitRange>[8:6]</bitRange>
                     <description>ADC U PGA config bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>OSC_CTRL2</name>
               <description>system oscillator control No.2</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>HOSC_FREQ</name>
                     <bitRange>[2:0]</bitRange>
                     <description>freq of external high-frequence oscillator select bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>7M4</name>
                           <description>external high-frequence oscillator freq = 7.3728MHz</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7</name>
                           <description>external high-frequence oscillator freq = 14.7456Mhz</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5_PLUS</name>
                           <description>external high-frequence oscillator freq = 29.4912Mhz (driver enhanced)</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HOSC_PD</name>
                     <bitRange>[3:3]</bitRange>
                     <description>HOSC disable bit (=1 disable HOSC, =0 enable HOSC)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>power on</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>power off</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PLL_HOSC_SEL</name>
                     <bitRange>[4:4]</bitRange>
                     <description>system clock selection bits for full speed mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PLL</name>
                           <description>select PLL as system clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HOSC</name>
                           <description>select HOSC as system clock</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PLL_FREQ</name>
                     <bitRange>[7:5]</bitRange>
                     <description>PLL freq selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>7M4</name>
                           <description>PLL freq select 7.3728MHz</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7</name>
                           <description>PLL freq select 14.7456Mhz</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5</name>
                           <description>PLL freq select 29.4912Mhz</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>59M_DIV2</name>
                           <description>PLL freq select 58.9824Mhz divided by 2</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LOSC_PD</name>
                     <bitRange>[8:8]</bitRange>
                     <description>LOSC power down switch bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>power on</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>power off</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LOSC_WEN</name>
                     <bitRange>[9:9]</bitRange>
                     <description>LOSC_PD writable enable/disable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>LOSC_PD write disable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>LOSC_PD write enable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field enums="ALL_ENUM">
                     <name>RCL_LOSC_SYS_SEL</name>
                     <bitRange>[12:12]</bitRange>
                     <description>system clock selection bit for low frequency mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LOSC</name>
                           <description>select LOSC</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCL</name>
                           <description>select RCL</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="RCL_LOSC_SYS_SEL">
                     <name>RCL_LCD</name>
                     <bitRange>[13:13]</bitRange>
                     <description>clock selection bit (RCL/LOSC) for LCD</description>
                  </field>
                  <field derivedFrom="RCL_LOSC_SYS_SEL">
                     <name>RCL_LOSC_RTC_SEL</name>
                     <bitRange>[14:14]</bitRange>
                     <description>clock selection bit (RCL/LOSC) for RTC</description>
                  </field>
                  <field derivedFrom="RCL_LOSC_SYS_SEL">
                     <name>RCL_LOSC_FLT_SEL</name>
                     <bitRange>[15:15]</bitRange>
                     <description>clock selection bit (RCL/LOSC) for KBI filter</description>
                  </field>
                  <field>
                     <name>RCH_FREQ</name>
                     <bitRange>[18:16]</bitRange>
                     <description>RCH frequency selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1M8</name>
                           <description>internal RCH freq select 1.8432MHz</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3M6</name>
                           <description>internal RCH freq select 3.6864MHz</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7M4</name>
                           <description>internal RCH freq select 7.3728MHz</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7</name>
                           <description>internal RCH freq select 14.7456Mhz</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5</name>
                           <description>internal RCH freq select 29.4912Mhz</description>
                           <value>4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RCM_PD</name>
                     <bitRange>[20:20]</bitRange>
                     <description>internal RCM enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>power off</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>power on</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PM_SEL</name>
                     <bitRange>[22:22]</bitRange>
                     <description>EMU power mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NORM</name>
                           <description>select as normal mode</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NVM</name>
                           <description>select as NVM mode</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYS_RST</name>
               <description>system reset  register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>EMU_RST_REQ</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>EMU module soft reset cfg bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable module soft reset</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable module soft reset</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="EMU_RST_REQ">
                     <name>NVM_RST_REQ</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>NVM module soft reset cfg bit</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>LOCKUP_ENRST</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>selection for the connection of lockup and system reset</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>lock up can not cause system reset</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>lock up cause system reset</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="EMU_RST_REQ">
                     <name>EMUREG_RST_REQ</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>EMU/NVM/FLK module soft reset cfg bit</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>POWEROK_RST</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>power-on reset flag (=1 reset ccured)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OCC</name>
                           <description>reset occured</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>reset not occured</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="POWEROK_RST">
                     <name>PIN_RST</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>external pin reset flag (=1 reet occured)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="POWEROK_RST">
                     <name>WDT_RST</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>WDT reset flag (=1 reset occurd)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field derivedFrom="POWEROK_RST">
                     <name>MCU_RST</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>CPU reset flag(software or LOCKUP) (=1 reset occured)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>BOR_V2P8_ENRST</name>
                     <access>read-write</access>
                     <bitRange>[9:9]</bitRange>
                     <description>lower than BOR 2.8V threshold reset CPU cfg bit</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>BOR_V2P8_IE</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
                     <description>BOR 2.8V threshold interrupt enable bit</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>BOR_V2P8_IF</name>
                     <access>read-write</access>
                     <bitRange>[11:11]</bitRange>
                     <description>BOR 2.8V threshold interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field enums="NO_ENUM">
                     <name>CM0_ENRST</name>
                     <access>read-write</access>
                     <bitRange>[12:12]</bitRange>
                     <description>CM0 reset enable bit(do not reset EMU related module)</description>
                  </field>
                  <field derivedFrom="POWEROK_RST">
                     <name>CM0_RST</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>CM0 reset flag</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>UART0_CLKG</name>
                     <access>read-write</access>
                     <bitRange>[14:14]</bitRange>
                     <description>UART0 CM0 reset lock enable bit(during CM0 reset period lock transmission between CPU and UART)</description>
                  </field>
                  <field derivedFrom="UART0_CLKG">
                     <name>UART1_CLKG</name>
                     <access>read-write</access>
                     <bitRange>[15:15]</bitRange>
                     <description>UART1 CM0 reset lock enable bit(during CM0 reset period lock transmission between CPU and UART)</description>
                  </field>
                  <field derivedFrom="UART0_CLKG">
                     <name>UART2_CLKG</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>UART2 CM0 reset lock enable bit(during CM0 reset period lock transmission between CPU and UART)</description>
                  </field>
                  <field derivedFrom="UART0_CLKG">
                     <name>UART3_CLKG</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>UART3 CM0 reset lock enable bit(during CM0 reset period lock transmission between CPU and UART)</description>
                  </field>
                  <field derivedFrom="UART0_CLKG">
                     <name>UART4_CLKG</name>
                     <access>read-write</access>
                     <bitRange>[18:18]</bitRange>
                     <description>UART4 CM0 reset lock enable bit(during CM0 reset period lock transmission between CPU and UART)</description>
                  </field>
                  <field derivedFrom="UART0_CLKG">
                     <name>UART5_CLKG</name>
                     <access>read-write</access>
                     <bitRange>[19:19]</bitRange>
                     <description>UART5 CM0 reset lock enable bit(during CM0 reset period lock transmission between CPU and UART)</description>
                  </field>
                  <field derivedFrom="EMU_RST_REQ">
                     <name>I2C_RST_REQ</name>
                     <access>read-write</access>
                     <bitRange>[20:20]</bitRange>
                     <description>I2C module soft reset cfg bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MAP_CTRL</name>
               <description>system control register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>REMAP</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
                     <description>system remap address configuration bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>FLASH mapped at address 0</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>FLASH mapped at address 1/2 (2nd FLASH at 0x0, 1st FLASH at 0x4000 and bootload at 0)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>FLASH switch mapping address with SRAM(FLASH at 0x10000000 and SRAM at 0)</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>BOOTROM mapped at address 0</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
