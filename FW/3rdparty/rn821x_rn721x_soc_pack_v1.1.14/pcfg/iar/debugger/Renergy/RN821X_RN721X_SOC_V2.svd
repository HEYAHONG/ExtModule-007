                  <field>
                     <name>RX_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>receive interrupt enable</description>
                  </field>
                  <field>
                     <name>ERR_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>transfer error interrupt enable</description>
                  </field>
                  <field>
                     <name>BGT_EN</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>BGT enable</description>
                  </field>
                  <field>
                     <name>PARSEL</name>
                     <access>read-write</access>
                     <bitRange>[10:8]</bitRange>
                     <description>parity selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>no parity</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ODD</name>
                           <description>odd parity</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EVEN</name>
                           <description>even parity</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ZERO</name>
                           <description>static zero parity</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ONE</name>
                           <description>static one parity</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>USER</name>
                           <description>user defined parity</description>
                           <value>5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ERRWTH</name>
                     <access>read-write</access>
                     <bitRange>[12:11]</bitRange>
                     <description>error signal width selection.applicable for RXPAR_ESEL=1 when receive</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2ETU</name>
                           <description>select 2 etu as error signal width</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1ETU</name>
                           <description>select 1 etu as error signal width</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1P5ETU</name>
                           <description>select 1.5 etu as error signal width</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXPAR_ESEL</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
