                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>postive adc input</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>negative adc input</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
