                     <name>PID34</name>
                     <bitRange>[4:4]</bitRange>
                     <description>P34 output mode cfg bit</description>
                  </field>
                  <field derivedFrom="PID30">
                     <name>PID35</name>
                     <bitRange>[5:5]</bitRange>
                     <description>P35 output mode cfg bit</description>
                  </field>
                  <field derivedFrom="PID30">
                     <name>PID36</name>
                     <bitRange>[6:6]</bitRange>
                     <description>P36 output mode cfg bit</description>
                  </field>
                  <field derivedFrom="PID30">
                     <name>PID37</name>
                     <bitRange>[7:7]</bitRange>
                     <description>P37 output mode cfg bit</description>
                  </field>
                  <field enums="ALL_ENUM">
                     <name>PIL30</name>
                     <bitRange>[8:8]</bitRange>
                     <description>P30 input mode cfg bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CMOS</name>
                           <description>select as CMOS input mode, Vil=0.3VCC Vih = 0.7VCC</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TTL</name>
                           <description>select as TTL input mode, Vil=0.16VCC Vih = 0.4VCC</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="PIL30">
                     <name>PIL31</name>
                     <bitRange>[9:9]</bitRange>
                     <description>P31 input mode cfg bit</description>
                  </field>
                  <field derivedFrom="PIL30">
                     <name>PIL32</name>
                     <bitRange>[10:10]</bitRange>
                     <description>P32 input mode cfg bit</description>
                  </field>
                  <field derivedFrom="PIL30">
                     <name>PIL33</name>
                     <bitRange>[11:11]</bitRange>
                     <description>P33 input mode cfg bit</description>
                  </field>
                  <field derivedFrom="PIL30">
                     <name>PIL34</name>
                     <bitRange>[12:12]</bitRange>
                     <description>P34 input mode cfg bit</description>
                  </field>
                  <field derivedFrom="PIL30">
                     <name>PIL35</name>
                     <bitRange>[13:13]</bitRange>
                     <description>P35 input mode cfg bit</description>
                  </field>
                  <field derivedFrom="PIL30">
                     <name>PIL36</name>
                     <bitRange>[14:14]</bitRange>
                     <description>P36 input mode cfg bit</description>
                  </field>
                  <field derivedFrom="PIL30">
                     <name>PIL37</name>
                     <bitRange>[15:15]</bitRange>
                     <description>P37 input mode cfg bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>LURT_CFG</name>
               <description>LPUART config register</description>
               <addressOffset>0x100</addressOffset>
               <fields>
                  <field>
                     <name fieldName="None">LURT_CFG</name>
                     <bitRange>[2:0]</bitRange>
                     <description>LPUART and UARTx IO cfg bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>do not use LPUART</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART0</name>
                           <description>LPUART use UART0 IO</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART1</name>
                           <description>LPUART use UART1 IO</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART2</name>
                           <description>LPUART use UART2 IO</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART3</name>
                           <description>LPUART use UART3 IO</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART4</name>
                           <description>LPUART use UART4 IO</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART5</name>
                           <description>LPUART use UART5 IO</description>
                           <value>6</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IOCFG</name>
               <description>IO congfig register</description>
               <addressOffset>0x104</addressOffset>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>P14</name>
                     <bitRange>[0:0]</bitRange>
                     <description>P14 IO driving capability select bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>FAST</name>
                           <description>select as slew rate fast mode, have driving capability of 3mA</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SLOW</name>
                           <description>select as slew rate slow mode, have driving capability of 1.5mA</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>P15</name>
                     <bitRange>[1:1]</bitRange>
                     <description>P15 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P16</name>
                     <bitRange>[2:2]</bitRange>
                     <description>P16 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P17</name>
                     <bitRange>[3:3]</bitRange>
                     <description>P17 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P20</name>
                     <bitRange>[4:4]</bitRange>
                     <description>P20 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P21</name>
                     <bitRange>[5:5]</bitRange>
                     <description>P21 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P22</name>
                     <bitRange>[6:6]</bitRange>
                     <description>P22 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P23</name>
                     <bitRange>[7:7]</bitRange>
                     <description>P23 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P40</name>
                     <bitRange>[8:8]</bitRange>
                     <description>P40 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P41</name>
                     <bitRange>[9:9]</bitRange>
                     <description>P41 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P42</name>
                     <bitRange>[10:10]</bitRange>
                     <description>P42 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P43</name>
                     <bitRange>[11:11]</bitRange>
                     <description>P43 IO driving capability select bit</description>
                  </field>
                  <field>
                     <name>P44</name>
                     <bitRange>[12:12]</bitRange>
                     <description>P44 IO driving capability select bit</description>
