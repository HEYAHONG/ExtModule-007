                  <field>
                     <name>CF2_CFG</name>
                     <access>read-write</access>
                     <bitRange>[14:13]</bitRange>
                     <description>QF pin switch over config</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>PADD</name>
                     <access>read-write</access>
                     <bitRange>[17:15]</bitRange>
                     <description>PF addition mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>P0</name>
                           <description>PA</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P1</name>
                           <description>PA</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P2</name>
                           <description>PB</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P3</name>
                           <description>|PA|+|PB|</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P4</name>
                           <description>+PA+PB</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>P5</name>
                           <description>+PA-PB</description>
                           <value>5</value>
                        </enumeratedValue>
