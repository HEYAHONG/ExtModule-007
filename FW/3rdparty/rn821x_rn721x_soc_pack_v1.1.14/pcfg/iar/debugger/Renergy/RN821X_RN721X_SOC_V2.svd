               <fields>
                  <field>
                     <name>TXDATA</name>
                     <bitRange>[7:0]</bitRange>
                     <description>transmit data value bits</description>
                  </field>
                  <field>
                     <name>UP</name>
                     <bitRange>[8:8]</bitRange>
                     <description>user-defined parity bit(valid when user-defined parity selected)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXD</name>
               <description>LPUART receives data buffer register</description>
               <addressOffset>0x14</addressOffset>
               <access>read-only</access>
               <resetMask>0x0</resetMask>
               <fields>
                  <field>
                     <name>RXDATA</name>
                     <bitRange>[7:0]</bitRange>
                     <description>read data value</description>
                  </field>
                  <field>
                     <name>UP</name>
                     <bitRange>[8:8]</bitRange>
                     <description>user-defined parity bit(valid when user-defined parity selected)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMR</name>
               <description>LPUART data matching register</description>
               <addressOffset>0x18</addressOffset>
               <size>8</size>
               <access>read-write</access>
               <resetMask>0x0</resetMask>
               <fields>
                  <field>
                     <name fieldName="None">DMR</name>
                     <bitRange>[7:0]</bitRange>
                     <description>LPUART data matches register bits</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>M2M</name>
         <description>DMA memory access</description>
         <groupName>DMA_M2M</groupName>
         <baseAddress>0x40068000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x20</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>MODE</name>
               <description>M2M mode register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
