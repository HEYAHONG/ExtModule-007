                           <description>data length select as 7 bits</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8</name>
                           <description>data length select as 8 bits</description>
                           <value>3</value>
                        </enumeratedValue>
