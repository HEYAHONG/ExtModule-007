      </peripheral>
      <peripheral>
         <name>I2C</name>
         <description>I2C controller</description>
         <groupName>I2C</groupName>
         <baseAddress>0x40024000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x14</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>I2C control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>I2C module enable bit</description>
                  </field>
                  <field>
                     <name>BUSCON</name>
                     <access>read-write</access>
                     <bitRange>[2:1]</bitRange>
                     <description>I2C bus control bit (when finish command transmision clear automatically)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>no action</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>START</name>
                           <description>generate start sequence (clear automatically when finish command transmision)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>STOP</name>
                           <description>generate stop sequence  (clear automatically when finish command transmision)</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRQE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>I2C interrupt enable bit</description>
                  </field>
                  <field>
                     <name>ACK</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>ACK signal configuration bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ACK</name>
                           <description>receive 9st SCL generate ACK</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>receive 9st SCL donot generate ACK</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MODE</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>I2C slave/master mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>S</name>
                           <description>select as slave device</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>M</name>
                           <description>select as master device</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLK</name>
               <description>I2C clock configuration register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <resetValue>0x1</resetValue>
               <fields>
                  <field>
                     <name>CLKDIV</name>
                     <bitRange>[2:0]</bitRange>
                     <description>I2C module clock divisor selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DEFAULT</name>
                           <description>select I2C module clock divisor as 10</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7M4_FM</name>
                           <description>when system clock = 7.3728Mhz,  select I2C as fast speed mode, module clock set at system clock divided by 20</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7_FM</name>
                           <description>when system clock = 14.7456Mhz, select I2C as fast speed mode, module clock set at system clock divided by 38</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5_FM</name>
                           <description>when system clock = 29.4912Mhz, select I2C as fast speed mode, module clock set at system clock divided by 76</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1M8_SM</name>
                           <description>when system clock = 1.8432Mhz , select I2C as standard speed mode, module clock set at system clock divided by 20</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3M6_SM</name>
                           <description>when system clock = 3.6864Mhz , select I2C as standard speed mode, module clock set at system clock divided by 38</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7M4_SM</name>
                           <description>when system clock = 7.3728Mhz , select I2C as standard speed mode, module clock set at system clock divided by 76</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7_SM</name>
                           <description>when system clock = 14.7456Mhz, select I2C as standard speed mode, module clock set at system clock divided by 154</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M5_SM</name>
                           <description>when system clock = 29.4912Mhz, select I2C as standard speed mode, module clock set at system clock divided by 306</description>
                           <value>6</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>I2C status indicate register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>STPD</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>interrupt flag of stop time sequence detection</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_NACK</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>interrupt flag of receive NACK interrupt</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TRANC</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>interrupt flag of transmit finish</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TXEMPT</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>transmit data registor empty error flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>OVERF</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>interrupt flag of receive data overflow</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>COL</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>interrupt flag of transmit conflict</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUSY</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>communication busy flag</description>
                  </field>
                  <field>
                     <name>MATCH</name>
                     <access>read-only</access>
                     <bitRange>[7:7]</bitRange>
                     <description>address match flag</description>
                  </field>
                  <field>
                     <name>DIR</name>
                     <access>read-only</access>
                     <bitRange>[8:8]</bitRange>
                     <description>receive/transmit direction flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>T</name>
                           <description>device as transmitting status</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R</name>
                           <description>device as receiving status</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>ADDR</name>
               <description>I2C slave device address register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>RW</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>receive/transmit direction configuration bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>T</name>
                           <description>configuration as transmit device</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R</name>
                           <description>configuration as receive device</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SADR</name>
                     <access>read-write</access>
                     <bitRange>[7:1]</bitRange>
                     <description>device address configuration bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DATA</name>
               <description>I2C data transmit/receive register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DATA</name>
                     <bitRange>[7:0]</bitRange>
                     <description>I2C transfer data bits</description>
                  </field>
               </fields>
            </register>
         </registers>
         <interrupt>
            <name>I2C</name>
            <value>11</value>
            <description>27 IIC Interrupt</description>
         </interrupt>
      </peripheral>
      <peripheral>
         <name>INTC</name>
         <description>interrupt controller for off-chip interrupt requests</description>
         <groupName>INTC</groupName>
         <baseAddress>0x40044000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x10</size>
            <usage>registers</usage>
         </addressBlock>
         <resetValue>0</resetValue>
         <registers>
            <register>
               <name>CTRL</name>
               <description>INTC control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN_INT0</name>
                     <bitRange>[0:0]</bitRange>
                     <description>external interrupt INT0 module enable bit</description>
                  </field>
                  <field>
                     <name>EN_INT1</name>
                     <bitRange>[1:1]</bitRange>
                     <description>external interrupt INT1 module enable bit</description>
                  </field>
                  <field>
                     <name>EN_INT2</name>
                     <bitRange>[2:2]</bitRange>
                     <description>external interrupt INT2 module enable bit</description>
                  </field>
                  <field>
                     <name>EN_INT3</name>
                     <bitRange>[3:3]</bitRange>
                     <description>external interrupt INT3 module enable bit</description>
                  </field>
                  <field>
                     <name>EN_INT4</name>
                     <bitRange>[4:4]</bitRange>
                     <description>external interrupt INT4 module enable bit</description>
                  </field>
                  <field>
                     <name>EN_INT5</name>
                     <bitRange>[5:5]</bitRange>
                     <description>external interrupt INT5 module enable bit</description>
                  </field>
                  <field>
                     <name>EN_INT6</name>
                     <bitRange>[6:6]</bitRange>
                     <description>external interrupt INT6 module enable bit</description>
                  </field>
                  <field>
                     <name>EN_INT7</name>
                     <bitRange>[7:7]</bitRange>
                     <description>external interrupt INT7 module enable bit</description>
                  </field>
                  <field>
                     <name>IRQ_CTRL</name>
                     <bitRange>[8:8]</bitRange>
                     <description>external interrupt mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INDEP</name>
                           <description>INT0~INT7 independent control by INTC_CTRL[7:0]</description>
                           <value>0</value>
                           <isDefault>true</isDefault>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXT0</name>
                           <description>INT0~INT7 share EXT0 IRQ vector, check STA while interrupt occured</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MODE</name>
               <description>INTC mode register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>INT0</name>
                     <bitRange>[1:0]</bitRange>
                     <description>external interrupt INT0 mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PE</name>
                           <description>external interrupt INT0 mode selection as posedge mode</description>
                           <value>0</value>
                           <isDefault>true</isDefault>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NE</name>
                           <description>external interrupt INT0 mode selection as negedge mode</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BE</name>
                           <description>external interrupt INT0 mode selection as both edge mode</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>INT1</name>
                     <bitRange>[3:2]</bitRange>
                     <description>external interrupt INT1 mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PE</name>
                           <description>external interrupt INT1 mode selection as posedge mode</description>
                           <value>0</value>
                           <isDefault>true</isDefault>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NE</name>
                           <description>external interrupt INT1 mode selection as negedge mode</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BE</name>
                           <description>external interrupt INT1 mode selection as both edge mode</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>INT2</name>
                     <bitRange>[5:4]</bitRange>
                     <description>external interrupt INT2 mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PE</name>
                           <description>external interrupt INT2 mode selection as posedge mode</description>
                           <value>0</value>
                           <isDefault>true</isDefault>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NE</name>
                           <description>external interrupt INT2 mode selection as negedge mode</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BE</name>
                           <description>external interrupt INT2 mode selection as both edge mode</description>
                           <value>2</value>
