                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ODD</name>
                           <description>parity type select as odd parity</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EVEN</name>
                           <description>parity type select as even parity</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0</name>
                           <description>parity type select as stick_zero parity</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
