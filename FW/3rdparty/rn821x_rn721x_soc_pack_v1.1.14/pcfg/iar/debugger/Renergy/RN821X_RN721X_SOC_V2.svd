                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>not any update found on PowerPA,PowerPB,PowerQ,IARMS,IBRMS and URMS</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OCC</name>
                           <description>update found on PowerPA,PowerPB,PowerQ,IARMS,IBRMS and URMS</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
