                     <name>IOCNT0_EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>IOCNT0 enable bit</description>
                  </field>
                  <field>
                     <name>IOCNT1_EN</name>
                     <bitRange>[1:1]</bitRange>
                     <description>IOCNT1 enable bit</description>
                  </field>
                  <field>
                     <name>IOCNT2_EN</name>
                     <bitRange>[2:2]</bitRange>
                     <description>IOCNT2 enable bit</description>
                  </field>
                  <field>
                     <name>IOCNT3_EN</name>
                     <bitRange>[3:3]</bitRange>
                     <description>IOCNT3 enable bit</description>
                  </field>
                  <field>
                     <name>IOCNT4_EN</name>
                     <bitRange>[4:4]</bitRange>
                     <description>IOCNT4 enable bit</description>
                  </field>
                  <field>
                     <name>IOCNT0_MODE</name>
                     <bitRange>[8:8]</bitRange>
                     <description>IOCNT0 count mode selection bit</description>
                  </field>
                  <field>
                     <name>IOCNT1_MODE</name>
                     <bitRange>[9:9]</bitRange>
                     <description>IOCNT1 count mode selection bit</description>
                  </field>
                  <field>
                     <name>IOCNT2_MODE</name>
                     <bitRange>[10:10]</bitRange>
                     <description>IOCNT2 count mode selection bit</description>
                  </field>
                  <field>
                     <name>IOCNT3_MODE</name>
                     <bitRange>[11:11]</bitRange>
                     <description>IOCNT3 count mode selection bit</description>
                  </field>
                  <field>
                     <name>IOCNT4_MODE</name>
                     <bitRange>[12:12]</bitRange>
                     <description>IOCNT4 count mode selection bit</description>
                  </field>
                  <field>
                     <name>CNT_CLR</name>
                     <bitRange>[16:16]</bitRange>
                     <description>pulse counter mode selection bit</description>
                  </field>
                  <field>
                     <name>FLT_BYPASS0</name>
                     <bitRange>[17:17]</bitRange>
                     <description>IOCNT0 FLT_BYPASS enable bit</description>
                  </field>
                  <field>
                     <name>FLT_BYPASS1</name>
                     <bitRange>[18:18]</bitRange>
                     <description>IOCNT1 FLT_BYPASS enable bit</description>
                  </field>
                  <field>
                     <name>FLT_BYPASS2</name>
                     <bitRange>[19:19]</bitRange>
                     <description>IOCNT2 FLT_BYPASS enable bit</description>
                  </field>
                  <field>
                     <name>FLT_BYPASS3</name>
                     <bitRange>[20:20]</bitRange>
                     <description>IOCNT3 FLT_BYPASS enable bit</description>
                  </field>
                  <field>
                     <name>FLT_BYPASS4</name>
                     <bitRange>[21:21]</bitRange>
                     <description>IOCNT4 FLT_BYPASS enable bit</description>
                  </field>
                  <field>
                     <name>FLT_CFG</name>
                     <bitRange>[31:25]</bitRange>
                     <description>IOCNT4~0 filter period config bits</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>ISO7816</name>
         <description>ISO7816 interface</description>
         <groupName>ISO7816</groupName>
         <baseAddress>0x40038000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x24</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL0</name>
               <description>ISO7816 No.0 control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>ISO7816 controller enable bit</description>
                  </field>
                  <field>
                     <name>DIRSEL</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>data encode and transfer direction selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LSB</name>
                           <description>data transfered with LSB first</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MSB</name>
                           <description>data toggled and transfered with MSB first</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TX_EN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>transmit enable bit</description>
                  </field>
                  <field>
                     <name>RX_EN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>receive enable bit</description>
                  </field>
                  <field>
                     <name>TX_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>transmit interrupt enable bit</description>
                  </field>
                  <field>
                     <name>RX_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>receive interrupt enable bit</description>
                  </field>
                  <field>
                     <name>ERR_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>transfer error interrupt enable bit</description>
                  </field>
                  <field>
                     <name>BGT_EN</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>BGT enable bit</description>
                  </field>
                  <field>
                     <name>PARSEL</name>
                     <access>read-write</access>
                     <bitRange>[10:8]</bitRange>
                     <description>parity selections</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>no parity</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ODD</name>
                           <description>odd parity</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EVEN</name>
                           <description>even parity</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ZERO</name>
                           <description>static zero parity</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ONE</name>
                           <description>static one parity</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>USER</name>
                           <description>user defined parity</description>
                           <value>5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ERRWTH</name>
                     <access>read-write</access>
                     <bitRange>[12:11]</bitRange>
                     <description>error signal width selection bits (applicable for RXPAR_ESEL=1 when receive)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2ETU</name>
                           <description>select 2 etu as error signal width</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1ETU</name>
                           <description>select 1 etu as error signal width</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1P5ETU</name>
                           <description>select 1.5 etu as error signal width</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXPAR_ESEL</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>handling way selection (when receive parity error) bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NULS</name>
                           <description>when parity error, set RX_PAR_ERR flag but do not return error signal</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SEND</name>
                           <description>when parity error, set RX_PAR_ERR flag and return error signal by T=0 protocol</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REP_CNT</name>
                     <access>read-write</access>
                     <bitRange>[16:14]</bitRange>
                     <description>data parity error resend times selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>do not resend when receive parity error</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>resend 1 time  when receive parity error</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>resend 2 times when receive parity error</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>resend 3 times when receive parity error</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>resend 4 times when receive parity error</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>5</name>
                           <description>resend 5 times when receive parity error</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>6</name>
                           <description>resend 6 times when receive parity error</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7</name>
                           <description>resend 7 times when receive parity error</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EGT</name>
                     <access>read-write</access>
                     <bitRange>[24:17]</bitRange>
                     <description>EGT width configuration bits</description>
                  </field>
                  <field>
                     <name>RX_GT</name>
                     <access>read-write</access>
                     <bitRange>[27:27]</bitRange>
                     <description>receive data GT selaction bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2ETU</name>
                           <description>select receive data GT as 2etu</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1ETU</name>
                           <description>select receive data GT as 1etu</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRL1</name>
               <description>ISO7816 No.1 control register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>controller enable</description>
                  </field>
                  <field>
                     <name>DIRSEL</name>
                     <access>read-write</access>
