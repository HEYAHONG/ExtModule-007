      <peripheral>
         <name>EMU</name>
         <description>energy metering unit</description>
         <groupName>METER</groupName>
         <baseAddress>0x50004000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x4d0</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>EMUCON</name>
               <description>Control</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>PRUN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>active power accumulation and PF pulse output</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>stop accumulating active power and outputing PF pulse</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>start accumulating active power and outputing PF pulse</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>QRUN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>reactive power accumulation and QF pulse output</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>stop accumulating reactive power and outputing QF pulse</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>start accumulating reactive power and outputing QF pulse</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SRUN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>reactive power accumulation and SF pulse output</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>stop accumulating reactive power and outputing SF pulse</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>start accumulating reactive power and outputing SF pulse</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CFSU</name>
                     <access>read-write</access>
                     <bitRange>[4:3]</bitRange>
                     <description>PF/QF output acceleration rate</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2</name>
                           <description>PF/QF output rate accelerated at x2</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>PF/QF output rate accelerated at x4</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8</name>
                           <description>PF/QF output rate accelerated at x8</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16</name>
                           <description>PF/QF output rate accelerated at x16</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CFSUEN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>PF/QF output acceleration enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>PF/QF output rate set as normal</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>accelerating PF/QF output rate defined as CFSU</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HPFUOFF</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>U-channel digital high-pass filters enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable DHPF in U-channel</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable DHPF in U-channel</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HPFIAOFF</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>IA-channel digital high-pass filters enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable DHPF in IA-channel</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable DHPF in IA-channel</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HPFIBOFF</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>IB-channel digital high-pass filters enable</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable DHPF in IB-channel</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable DHPF in IB-channel</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ENERGY_CLR</name>
                     <access>read-write</access>
                     <bitRange>[9:9]</bitRange>
                     <description>all register clear as 0 after reading</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLEAR</name>
                           <description>all register clear as 0 after reading</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HOLD</name>
                           <description>all register hold on after reading</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ZXD0</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
                     <description>zero-crossing point selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>POS</name>
                           <description>select positive zero-crossing point</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEG</name>
                           <description>select negative zero-crossing point</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ZXD1</name>
                     <access>read-write</access>
                     <bitRange>[11:11]</bitRange>
                     <description>ZX output mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>toggle ZX only at zero crossing point defined by ZXD0</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>toggle ZX only at both positive and negative zero crossing point</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PMOD</name>
                     <access>read-write</access>
                     <bitRange>[13:12]</bitRange>
                     <description>active power accumulation mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>POSNEG</name>
                           <description>accumulating both positive and negative power,keeping sign to negative power</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>POS</name>
                           <description>accumulating only positive</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ABS</name>
                           <description>accumulating absolute value of both positive and negative power</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEG</name>
                           <description>do not use</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>QMOD</name>
                     <access>read-write</access>
                     <bitRange>[15:14]</bitRange>
                     <description>reactive power accumulation mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>POSNEG</name>
                           <description>accumulating both positive and negative power,keeping sign to negative power</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>POS</name>
                           <description>accumulating only positive</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ABS</name>
                           <description>accumulating absolute value of both positive and negative power</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEG</name>
                           <description>do not use</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>U_START</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>apparent power U-channel selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>count U-channel when calculate apparent power</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>ignore U-channel when calculate apparent power</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CF3_CFG</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>PIN SF redefine</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SF1</name>
                           <description>redefine SF as SF1</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SF2</name>
                           <description>redefine SF as SF2</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>P2RUN</name>
                     <access>read-write</access>
                     <bitRange>[18:18]</bitRange>
                     <description>enable active power register 2 accumulate</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable active power register 2 accumulate</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable active power register 2 accumulate</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>Q2RUN</name>
                     <access>read-write</access>
                     <bitRange>[19:19]</bitRange>
                     <description>enable reactive power register 2 accumulate</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable reactive power register 2 accumulate</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable reactive power register 2 accumulate</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>S2RUN</name>
                     <access>read-write</access>
                     <bitRange>[20:20]</bitRange>
                     <description>enable apparent power register 2 accumulate</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable apparent power register 2 accumulate</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable apparent power register 2 accumulate</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SAG_FREQ_SEL</name>
                     <access>read-write</access>
