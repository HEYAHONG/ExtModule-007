                  </field>
               </fields>
            </register>
            <register>
               <name>STA0</name>
               <description>ISO7816 No.0 status register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TXIF</name>
                     <access>read-write</access>
